'' 下線
Sub UnderlineBottomOfSelection()

    Dim lastRow As Long
    Dim rng As Range

    If TypeName(Selection) <> "Range" Then Exit Sub

    ' 選択範囲の最下行番号
    lastRow = Selection.rows(Selection.rows.Count).row

    ' 選択範囲の列幅を維持したまま最下行を取得
    Set rng = Intersect(Selection.Worksheet.rows(lastRow), Selection)

    rng.Borders(xlEdgeBottom).LineStyle = xlContinuous
    rng.Borders(xlEdgeBottom).Weight = xlThin   ' 太さ調整（xlMedium / xlThick）

End Sub

'' ハイライト
Public Sub HighlightFromClipboard_Red()

    Dim clipText As String
    Dim c As Range
    Dim pos As Long

    If TypeName(Selection) <> "Range" Then Exit Sub

    clipText = GetClipboardText()
    If clipText = "" Then Exit Sub

    On Error GoTo ErrHandler

    Application.ScreenUpdating = False

    For Each c In Selection.Cells

        If Not IsError(c.Value) Then

            pos = InStr(1, CStr(c.Value), clipText, vbBinaryCompare)

            Do While pos > 0

                With c.Characters(pos, Len(clipText)).Font
                    .Color = vbRed
                    .Bold = True
                End With

                pos = InStr( _
                    pos + Len(clipText), _
                    CStr(c.Value), _
                    clipText, _
                    vbBinaryCompare _
                )

            Loop

        End If

    Next c

ExitPoint:
    Application.ScreenUpdating = True
    Exit Sub

ErrHandler:
    Application.ScreenUpdating = True
    RaiseStatusError Err.Number, Err.source, Err.Description

End Sub

Public Sub SetRedBold()

    If TypeName(Selection) <> "Range" Then Exit Sub

    With Selection.Font
        .Color = vbRed
        .Bold = True
    End With

End Sub

Public Sub SetBlueBold()

    If TypeName(Selection) <> "Range" Then Exit Sub

    With Selection.Font
        .Color = RGB(0, 176, 240)
