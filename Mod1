' @Feature: Layer
' @Section: ExDSL
' @Role: Command
' @Summary: Workbook内のL[]セルにWorksheet Hyperlinkを再構築する
' @Status: Review
Public Sub RebuildLayerHyperlinks()

    Dim wb As Workbook
    Set wb = GetCurrentWorkbook()

    Application.ScreenUpdating = False
    Application.EnableEvents = False

    On Error GoTo ERR_HANDLER

    RebuildLayerHyperlinksInWorkbook wb

    Application.EnableEvents = True
    Application.ScreenUpdating = True

    ShowStatus "L[]リンクを再構築しました"
    Exit Sub

ERR_HANDLER:

    Application.EnableEvents = True
    Application.ScreenUpdating = True

    RaiseStatusError _
        Err.Number, _
        "RebuildLayerHyperlinks", _
        Err.Description

End Sub

Private Sub RebuildLayerHyperlinksInWorkbook( _
    ByVal wb As Workbook _
)

    Dim ws As Worksheet

    For Each ws In wb.Worksheets

        Dim cell As Range

        For Each cell In ws.UsedRange.Cells

            If VarType(cell.Value) = vbString Then

                Dim linkText As String
                linkText = CStr(cell.Value)

                Dim SheetName As String
                SheetName = ParseLayerLink(linkText)

                If Len(SheetName) > 0 Then

                    If WorksheetExists(SheetName, wb) Then

                        RebuildLayerHyperlink _
                            cell, _
                            wb.Worksheets(SheetName)

                    Else

                        Debug.Print _
                            "未リンク：シート [" & _
                            SheetName & _
                            "] が存在しません"

                    End If

                End If

            End If

        Next cell

    Next ws

End Sub

Private Sub RebuildLayerHyperlink( _
    ByVal sourceCell As Range, _
    ByVal targetWs As Worksheet _
)

    If sourceCell.Hyperlinks.Count > 0 Then
        sourceCell.Hyperlinks.Delete
    End If

    sourceCell.Font.ColorIndex = xlAutomatic
    sourceCell.Font.Underline = xlUnderlineStyleNone

    sourceCell.Worksheet.Hyperlinks.Add _
        Anchor:=sourceCell, _
        Address:="", _
        SubAddress:="'" & targetWs.Name & "'!A1", _
        TextToDisplay:=CStr(sourceCell.Value)

End Sub


' @Feature: Layer
' @Section: ExDSL
' @Role: Command
' @Summary: 旧シート名・新シート名の一覧を適用し、L[]リンク更新とシート順変更を行う
' @Status: Review
Public Sub ApplySheetRenameList( _
    ByVal sourceAddress As String _
)

    Dim wb As Workbook
    Set wb = GetCurrentWorkbook()

    Dim sourceRange As Range
    Set sourceRange = ActiveSheet.Range(sourceAddress)

    If sourceRange.Columns.Count < 2 Then
        RaiseStatusError _
            vbObjectError + 1200, _
            "ApplySheetRenameList", _
            "Source range must contain OldName and NewName columns."
    End If

    Dim baseSheet As Worksheet
    Set baseSheet = ActiveSheet

    Dim previousSheet As Worksheet
    Set previousSheet = baseSheet

    Dim rowIndex As Long

    For rowIndex = 1 To sourceRange.rows.Count

        Dim targetSheet As Worksheet

        Set targetSheet = ApplySheetRenameRow( _
            wb, _
            sourceRange, _
            rowIndex _
        )

        If Not targetSheet Is Nothing Then

            If targetSheet.index <> previousSheet.index + 1 Then
                targetSheet.Move After:=previousSheet
            End If

            Set previousSheet = targetSheet

        End If

    Next rowIndex

    baseSheet.Activate

End Sub


Private Function ApplySheetRenameRow( _
    ByVal wb As Workbook, _
    ByVal sourceRange As Range, _
    ByVal rowIndex As Long _
) As Worksheet

    Dim oldName As String
    Dim newName As String

    oldName = Trim$(CStr(sourceRange.Cells(rowIndex, 1).Value))
    newName = Trim$(CStr(sourceRange.Cells(rowIndex, 2).Value))

    If Len(oldName) = 0 Then Exit Function

    If Not WorksheetExists(oldName, wb) Then Exit Function

    Dim ws As Worksheet
    Set ws = wb.Worksheets(oldName)

    ' 名前変更なしでも並び順適用対象として返す
    If Len(newName) = 0 Or oldName = newName Then
        Set ApplySheetRenameRow = ws
        Exit Function
    End If

    If WorksheetExists(newName, wb) Then
        RaiseStatusError _
            vbObjectError + 1201, _
            "ApplySheetRenameRow", _
            "Destination worksheet already exists: " & newName
    End If

    ws.Name = newName

    ReplaceLayerLinks _
        wb, _
        oldName, _
        newName

    Set ApplySheetRenameRow = ws

End Function

' @Feature: Layer
' @Section: ExDSL
' @Role: Command
' @Summary: 指定範囲のL[]リンク先Worksheetを選択したWorkbookへ移動する
' @Status: Review
Public Sub MoveLinkedSheetsToWorkbook( _
    ByVal sourceAddress As String _
)

    Dim sourceWb As Workbook
    Set sourceWb = GetCurrentWorkbook()

    Dim sourceRange As Range
    Set sourceRange = ActiveSheet.Range(sourceAddress)

    Dim moveList As Object
    Set moveList = BuildLayerLinkList(sourceRange)

    If moveList.Count = 0 Then
        ShowStatus "L[]が見つかりません"
        Exit Sub
    End If

    Dim targetWb As Workbook
    Set targetWb = SelectTargetWorkbook()

    If targetWb Is Nothing Then Exit Sub

    MoveWorksheetsByName _
        sourceWb, _
        targetWb, _
        moveList

End Sub

Private Function BuildLayerLinkList( _
    ByVal sourceRange As Range _
) As Object

    Dim Result As Object
    Set Result = CreateObject("Scripting.Dictionary")

    Dim cell As Range

    For Each cell In sourceRange.Cells

        If VarType(cell.Value) = vbString Then

            Dim SheetName As String
            SheetName = ParseLayerLink(CStr(cell.Value))

            If Len(SheetName) > 0 Then
                Result(SheetName) = True
            End If

        End If

    Next cell

    Set BuildLayerLinkList = Result

End Function

Private Function SelectTargetWorkbook() As Workbook

    Dim filePath As Variant

    filePath = Application.GetOpenFilename( _
        "Excelファイル (*.xlsx;*.xlsm), *.xlsx;*.xlsm", _
        , _
        "移動先ブックを選択" _
    )

    If VarType(filePath) = vbBoolean Then
        If filePath = False Then Exit Function
    End If

    Set SelectTargetWorkbook = Workbooks.Open(CStr(filePath))

End Function

Private Sub MoveWorksheetsByName( _
    ByVal sourceWb As Workbook, _
    ByVal targetWb As Workbook, _
    ByVal moveList As Object _
)

    Dim key As Variant

    For Each key In moveList.keys

        Dim SheetName As String
        SheetName = CStr(key)

        If Not WorksheetExists(SheetName, sourceWb) Then
            ShowStatus "存在しないシート: " & SheetName
            GoTo CONTINUE_LOOP
        End If

        If WorksheetExists(SheetName, targetWb) Then
            ShowStatus "移動先に既に存在: " & SheetName
            GoTo CONTINUE_LOOP
        End If

        sourceWb.Worksheets(SheetName).Move _
            After:=targetWb.Worksheets(targetWb.Worksheets.Count)

CONTINUE_LOOP:

    Next key

End Sub




