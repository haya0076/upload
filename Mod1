' @Feature: FileSystem
' @Section: Worker
' @Role: Builder
Private Sub AppendFolderTree( _
    ByRef tbl As cls_TBL, _
    ByVal folder As Object, _
    ByVal level As Long _
)

    tbl.addRow Array( _
        level, _
        "Folder", _
        folder.Name, _
        folder.Path _
    )

    Dim subFolder As Object

    For Each subFolder In folder.SubFolders
        AppendFolderTree tbl, subFolder, level + 1
    Next subFolder

    Dim file As Object

    For Each file In folder.Files

        tbl.addRow Array( _
            level + 1, _
            "File", _
            file.Name, _
            file.Path _
        )

    Next file

End Sub



