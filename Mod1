Public Sub RunMacroFromSelection()

    On Error GoTo errLabel

    Dim tasks() As ExDslTask
    Dim taskCount  As Long
    
    ' ExDSL形式に該当するセルを抽出
    tasks = ExDslTasksFromSelection(taskCount)
    If taskCount = 0 Then Exit Sub

    ' ExDSLフォーマット判定
    RequireExDSL tasks
    
    ' ExDSLをExpressionへ変換
    Dim expressions As Collection
    Set expressions = ParseExDslTasks(tasks)
    
    ' Invocationへ変換
    Dim Invocations As Collection
    Set Invocations = BuildInvocations(expressions)
    
    'Invocationからマクロ実行
    RunMacroInvocations Invocations
    
    Exit Sub
    

errLabel:

    Debug.Print Err.Number, Err.source, Err.Description

End Sub

' SelectionからExDslTask形式を作成
Public Function ExDslTasksFromSelection( _
    ByRef taskCount As Long _
) As ExDslTask()

    Dim targetRange As Range
    Dim foundCell As Range
    Dim firstAddress As String

    Dim tasks() As ExDslTask

    If TypeName(Selection) <> "Range" Then
        RaiseStatusError vbObjectError + 1000, _
                  "ExDslTasksFromSelection", _
                  "Selection is not a Range."
    End If

    Set targetRange = Selection

    With targetRange

        Set foundCell = .Find( _
            What:="*(*", _
            LookIn:=xlValues, _
            LookAt:=xlPart)

        If Not foundCell Is Nothing Then

            firstAddress = foundCell.Address

            Do

                taskCount = taskCount + 1
                ReDim Preserve tasks(1 To taskCount)

                tasks(taskCount).Value = CStr(foundCell.Value2)

                Set foundCell = .FindNext(foundCell)

            Loop While Not foundCell Is Nothing _
                   And foundCell.Address <> firstAddress

        End If

    End With

    ExDslTasksFromSelection = tasks

End Function

Public Sub RequireExDSL(ByRef candidates() As ExDslTask)

    Dim i As Long

    For i = LBound(candidates) To UBound(candidates)

        If Not IsValidExDSL(candidates(i).Value) Then
            
            RaiseStatusError vbObjectError + 1000, _
                      "Mod_Contracts.RequireExDSL", _
                      "ExDSL validation failed."
        
        End If
        
    Next i


End Sub

Public Function IsValidExDSL(ByVal Value As String) As Boolean

    Dim posOpen As Long
    Dim posClose As Long
    Dim header As String
    Dim Identifier As String
    Dim argumentsText As String
    Dim posDot As Long

    If Len(Value) = 0 Then Exit Function
    If Len(Value) < 2 Then Exit Function

    posOpen = InStr(Value, "(")
    posClose = InStrRev(Value, ")")

    ' Identifier部分が存在しない
    If posOpen <= 1 Then Exit Function

    ' 閉じ括弧がない、または順序異常
    If posClose <= posOpen Then Exit Function

    ' Identifier / Command 部
    header = Left$(Value, posOpen - 1)

    ' Identifier取得
    posDot = InStr(header, ".")

    If posDot > 0 Then
        Identifier = Left$(header, posDot - 1)
    Else
        Identifier = header
    End If

    If Not IsRegisteredIdentifier(Identifier) Then Exit Function
    
    ' Argumentsが空
    argumentsText = Mid$(Value, _
                         posOpen + 1, _
                         posClose - posOpen - 1)

    If Identifier = "M" And Len(Trim$(argumentsText)) = 0 Then Exit Function
    
    ' Content部
    Dim suffix As String
    
    suffix = Mid$(Value, posClose + 1)
    
    If Len(suffix) > 0 Then
    
        If Left$(suffix, 1) <> "[" Then Exit Function
        If Right$(suffix, 1) <> "]" Then Exit Function
    
    End If
    

    IsValidExDSL = True

End Function

Public Function ParseExDslTasks( _
    ByRef tasks() As ExDslTask _
) As Collection

    Dim expressions As Collection
    Set expressions = New Collection

    Dim i As Long

    For i = LBound(tasks) To UBound(tasks)

        expressions.Add ParseExDslTask(tasks(i))

    Next i

    Set ParseExDslTasks = expressions

End Function

Private Function ParseExDslTask( _
    ByRef task As ExDslTask _
) As Cls_ExDsl_Expression

    Dim expression As Cls_ExDsl_Expression
    Set expression = New Cls_ExDsl_Expression
    
    Dim Value As String
    Value = task.Value
    
    Dim posOpen As Long
    Dim posClose As Long
    Dim header As String
    Dim Identifier As String
    Dim argumentsText As String
    
'    Dim Arguments As Collection
'    Dim posDot As Long
'
    Dim Command As String
    Dim Content As String
    
    posOpen = InStr(Value, "(")
    posClose = InStrRev(Value, ")")

    ' Header 部分
    header = Left$(Value, posOpen - 1)
    ParseHeader header, Identifier, Command
    
    expression.Identifier = Identifier
    expression.Command = Command
    
    ' Contentは次工程
    Content = ParseContent(Value, posClose)
    expression.Content = Content
    
    ' Arguments 部分
    argumentsText = Mid$(Value, _
                         posOpen + 1, _
                         posClose - posOpen - 1)
                             
    Dim args() As String
    Dim i As Long
    
    args = ParseArguments(argumentsText)
    
    For i = LBound(args) To UBound(args)
        expression.AddArgument args(i)
    Next i

    ' DEBUG
    ' =========================================================
'
'    Debug.Print "Identifier = " & expression.Identifier
'    Debug.Print "Command    = " & expression.Command
'    Debug.Print "Content    = " & expression.Content
'
'    Dim ii As Long
'    Dim out As String
'    For ii = 1 To expression.ArgumentCount
'        out = out & expression.GetArgument(ii) & ","
'    Next ii
'    out = "Arguments    = [" & out
'    out = Left(out, Len(out) - 1) & "]"
'    Debug.Print out
    ' =========================================================
    
    
    Set ParseExDslTask = expression
        
End Function

Private Sub ParseHeader( _
    ByVal header As String, _
    ByRef Identifier As String, _
    ByRef Command As String _
)

    Dim posDot As Long

    posDot = InStr(header, ".")

    If posDot > 0 Then

        Identifier = Left$(header, posDot - 1)
        Command = Mid$(header, posDot + 1)

    Else

        Identifier = header
        Command = vbNullString

    End If

End Sub

Private Function ParseArguments( _
    ByVal argumentsText As String _
) As String()

    Dim args() As String
    Dim i As Long

    args = Split(argumentsText, ",")

    For i = LBound(args) To UBound(args)
        args(i) = Trim$(args(i))
    Next i

    ParseArguments = args

End Function

Private Function ParseContent( _
        ByVal Value As String, _
        ByVal posClose As Long _
) As String
        
    Dim suffix As String
    suffix = Mid$(Value, posClose + 1)
    
    If Len(suffix) > 0 Then
    
        ParseContent = Mid(suffix, 2, Len(suffix) - 2)
      
    End If
    
    
End Function

Private Function BuildInvocations( _
