Public Function IsRegisteredIdentifier(ByVal Identifier As String) As Boolean

    Select Case Identifier
        Case "M", "L", "T", "SYS", "FS"
            IsRegisteredIdentifier = True
        Case Else
            Stop
            IsRegisteredIdentifier = False
    End Select

End Function

Public Function BuildInvocation( _
    ByRef expression As Cls_ExDsl_Expression _
) As Cls_ExDsl_Invocation

    Dim Invocation As Cls_ExDsl_Invocation
    Set Invocation = New Cls_ExDsl_Invocation

    Select Case expression.Identifier

        Case "M"

            Invocation.procedureName = _
                expression.GetArgument(1)

            Invocation.AddArguments _
                expression.GetArgumentsFrom(2)

        Case Else

            Invocation.procedureName = _
                ResolveProcedureName( _
                    expression.Identifier & "." & _
                    expression.Command)

            Invocation.AddArguments _
                expression.GetArgumentsFrom(1)

    End Select

    Set BuildInvocation = Invocation

End Function

Public Function ResolveProcedureName(ByVal key As String) As String

    Dim functionName As String
    
    Dim Identifier As String
    Dim Command As String
    
    Identifier = Split(key, ".")(0)
    Command = Split(key, ".")(1)

    Select Case UCase(Identifier)
        
    Case "L"
        Select Case Command
            Case "COPY"
                functionName = "CopyLayer"
            
            Case "SL"
                functionName = "OutputSheetList"
            
            Case "SORT"
                functionName = "ReorderSheets"

            Case "RNM"
                functionName = "ApplySheetRenameList"
                
            Case "MOV"
                functionName = "MoveLinkedSheetsToWorkbook"
                    
            Case "SBN"
                functionName = "SortSheetsByName"
                    
            Case Else
                Stop ' MYSTYPE
                
        End Select
    
    Case "FS"
    
        Select Case Command
                
            Case "EXPORT"
                functionName = "ExportBas"
            
            Case Else
    
        End Select

    
    Case "SYS"
        Select Case Command
            Case "CATALOG"
                functionName = "BuildCodeCatalog"
            
            Case Else
                Stop ' MYSTYPE
        
        End Select
    
    
    
    
'
'        Case "T.C"
'            functionName = "CreateTag"
'
'        Case "T.R"
'            functionName = "ReplaceTag"
'
    Case Else
        RaiseStatusError vbObjectError + 1002, _
                  "ResolveProcedureName", _
                  "Unknown dispatch key: " & key
    
    End Select
    

    ResolveProcedureName = functionName


End Function





