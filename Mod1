Public Sub ClearListTable( _
    ByVal headerRangeText As String _
)

    Dim headerRange As Range
    Set headerRange = ActiveSheet.Range(headerRangeText)

    Dim startRow As Long
    Dim startCol As Long
    Dim colCount As Long

    startRow = headerRange.row + 1
    startCol = headerRange.column
    colCount = headerRange.Columns.Count

    Dim lastRow As Long

    lastRow = GetListEndRow( _
        ActiveSheet, _
