' @Feature: Macro
' @Section: ExDSL
' @Role: Command
' @Summary: 指定した関数を起点に呼び出し関数を再帰展開して出力する
' @Status: Review
Public Sub BuildNestedCodeJp( _
    ByVal entryPoint As String, _
    ByVal baseHeaderRangeText As String, _
    ByVal outputHeaderRangeText As String _
)

    Dim ws As Worksheet
    Set ws = ActiveSheet

    Dim baseHeader As Range
    Dim outHeader As Range

    Set baseHeader = ws.Range(baseHeaderRangeText)
    Set outHeader = ws.Range(outputHeaderRangeText)


    Dim baseCols As Object
    Dim outCols As Object

    Set baseCols = GetHeaderMap( _
        ws, _
        baseHeader.row, _
        baseHeader.column _
    )

    Set outCols = GetHeaderMap( _
        ws, _
        outHeader.row, _
        outHeader.column _
    )


    RequireNestedCodeBaseHeaders baseCols
    RequireNestedCodeOutputHeaders outCols


    Dim funcMap As Object

    Set funcMap = BuildFunctionMap( _
        ws, _
        baseCols, _
        baseHeader.row + 1 _
    )


    If Not funcMap.Exists(entryPoint) Then

        RaiseStatusError _
            vbObjectError + 1600, _
            "BuildNestedCodeJp", _
            "Entry function not found: " & entryPoint

    End If


    Dim outRow As Long
    outRow = outHeader.row + 1


    ClearNestedCodeOutput _
        ws, _
        outRow, _
        outHeader.column, _
        outCols.Count


    Dim callStack As Object
    Set callStack = CreateObject("Scripting.Dictionary")


    Application.ScreenUpdating = False

    On Error GoTo ERR_HANDLER


    ExpandFunctionJp _
        baseWs:=ws, _
        outWs:=ws, _
        baseCols:=baseCols, _
        outCols:=outCols, _
        funcMap:=funcMap, _
        funcName:=entryPoint, _
        outRow:=outRow, _
        callStack:=callStack, _
        depth:=1


    Application.ScreenUpdating = True

    ShowStatus "BuildNestedCodeJp 完了"

    Exit Sub


ERR_HANDLER:

    Application.ScreenUpdating = True

    RaiseStatusError _
        Err.Number, _
        "BuildNestedCodeJp", _
        Err.Description

End Sub


Private Sub ClearNestedCodeOutput( _
    ByVal ws As Worksheet, _
    ByVal startRow As Long, _
    ByVal startCol As Long, _
    ByVal colCount As Long _
)

    Dim lastRow As Long

    lastRow = GetListEndRow( _
        ws, _
        startRow, _
        startCol, _
        colCount _
    )

    If lastRow < startRow Then Exit Sub


    ws.Range( _
        ws.Cells(startRow, startCol), _
        ws.Cells(lastRow, startCol + colCount - 1) _
    ).ClearContents

End Sub

Private Sub RequireNestedCodeBaseHeaders( _
    ByVal cols As Object _
)

    If Not cols.Exists("アドレス") _
        Or Not cols.Exists("階層") _
        Or Not cols.Exists("関数名") _
        Or Not cols.Exists("呼び出し関数") _
        Or Not cols.Exists("コード") Then

        RaiseStatusError _
            vbObjectError + 1601, _
            "RequireNestedCodeBaseHeaders", _
            "ベーステーブルに必要なヘッダがありません。"

    End If

End Sub


Private Sub RequireNestedCodeOutputHeaders( _
    ByVal cols As Object _
)

    If Not cols.Exists("階層") _
        Or Not cols.Exists("コード") _
        Or Not cols.Exists("アドレス") _
        Or Not cols.Exists("関数名") _
        Or Not cols.Exists("呼び出し関数") Then

        RaiseStatusError _
            vbObjectError + 1602, _
            "RequireNestedCodeOutputHeaders", _
            "出力テーブルに必要なヘッダがありません。"

    End If

End Sub



