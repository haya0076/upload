' @Summary: Add-in側のNameから設定値を取得する
' @Role: Config
' @Raises: 指定Config Name未登録
Private Function GetConfigValue( _
    ByVal configName As String _
) As String

    Dim nm As Name

    On Error Resume Next
    Set nm = ThisWorkbook.Names(configName)
    On Error GoTo 0

    If nm Is Nothing Then
        RaiseStatusError GetConfigErrorNumber(), _
                    "Entry_Config.GetConfigValue", _
                    "ReadConfig : ConfigName is not configured."
    End If

    Dim formula As String
    Dim Value As Variant

    formula = nm.RefersTo
    Value = Application.Evaluate(formula)

    GetConfigValue = CStr(Value)

End Function

