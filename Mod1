' @Feature: Tag
' @Section: Syntax
' @Role: Validator
' @Summary: 文字列がTAG[]形式か判定する
' @Status: Keep
Public Function IsTagFormat( _
    ByVal text As String _
) As Boolean

    Dim regEx As Object
    Set regEx = CreateObject("VBScript.RegExp")

    With regEx
        .pattern = "^[^\[\]]+\[[^\]]*\]$"
        .Global = False
        .IgnoreCase = False
    End With

    IsTagFormat = regEx.test(text)

End Function

' @Feature: Tag
' @Section: Syntax
' @Role: Parser
' @Summary: TAG[]形式からTag Identifierを取得する
' @Status: Keep
Public Function GetTagId( _
    ByVal tagText As String _
) As String

    Dim posOpen As Long
    posOpen = InStr(1, tagText, "[", vbBinaryCompare)

    If posOpen <= 1 Then Exit Function

    GetTagId = Left$(tagText, posOpen - 1)

End Function

' @Feature: Tag
' @Section: Syntax
' @Role: Builder
' @Summary: Tag指定を検索用正規表現へ変換する
' @Status: Keep
Public Function BuildTagPattern( _
    ByVal tagSpec As String _
) As String

    Dim Value As String
    Value = Trim$(tagSpec)

    Dim hasWildcard As Boolean
    hasWildcard = (Right$(Value, 2) = ".*")

    If hasWildcard Then
        Value = Left$(Value, Len(Value) - 2)
    End If

    Value = EscapeRegExp(Value)

    If hasWildcard Then

        BuildTagPattern = _
            Value & "(\.[^.[]+)*\[[^\]]*\]"

    Else

        BuildTagPattern = _
            Value & "\[[^\]]*\]"

    End If

End Function

' @Feature: Tag
' @Section: Syntax
' @Role: Parser
' @Summary: Tag指定からFind用の先頭Identifierを取得する
' @Status: Keep
Public Function GetTagFindKey( _
    ByVal tagSpec As String _
) As String

    Dim posDot As Long
    posDot = InStr(tagSpec, ".")

    If posDot > 0 Then
        GetTagFindKey = Left$(tagSpec, posDot - 1)
    Else
        GetTagFindKey = tagSpec
    End If

End Function



