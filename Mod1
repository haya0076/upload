Public Sub RunMacroInvocation( _
    ByRef Invocation As Cls_ExDsl_Invocation _
)
    
    Dim procedureName As String
    procedureName = Invocation.procedureName
    
    Select Case Invocation.ArgumentCount
    
        Case 0
            Application.Run procedureName

        Case 1
            Application.Run procedureName, _
                Invocation.GetArgument(1)

        Case 2
            Application.Run procedureName, _
                Invocation.GetArgument(1), _
                Invocation.GetArgument(2)

        Case 3
            Application.Run procedureName, _
                Invocation.GetArgument(1), _
                Invocation.GetArgument(2), _
                Invocation.GetArgument(3)

        Case 4
            Application.Run procedureName, _
                Invocation.GetArgument(1), _
                Invocation.GetArgument(2), _
                Invocation.GetArgument(3), _
                Invocation.GetArgument(4)

        Case 5
            Application.Run procedureName, _
                Invocation.GetArgument(1), _
                Invocation.GetArgument(2), _
                Invocation.GetArgument(3), _
                Invocation.GetArgument(4), _
                Invocation.GetArgument(5)

        Case Else
            RaiseStatusError vbObjectError + 1001, _
                      "RunMacroInvocation", _
                      "Too many arguments."
    End Select

    Exit Sub
    

End Sub




