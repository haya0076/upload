Option Explicit


' リスト作成 ネスト対応
Public Sub getTagList( _
    ByVal tagId As String, _
    ByVal outputHeaderRangeText As String _
)

    Dim outWs As Worksheet
    Dim outHeader As Range
    Dim ws As Worksheet
    Dim targetRange As Range
    Dim c As Range
    Dim regEx As Object
    Dim matches As Object
    Dim m As Object
    Dim outRow As Long
    Dim outCol As Long
    Dim firstAddress  As String
    Dim checkValue As String
    Dim rng As Range
    
    On Error GoTo ERR_HANDLER

    Set outWs = ActiveSheet
    Set outHeader = outWs.Range(outputHeaderRangeText)

    outRow = outHeader.row + 1
    outCol = outHeader.Column

    Dim clearLastRow As Long
    
    Dim searchTag As String
    Dim patternText As String
    
    searchTag = GetTagFindKey(tagId)
    patternText = BuildTagPattern(tagId)

    ' 現在の出力をクリア
    clearLastRow = GetListLastRow(outWs, outRow, outCol, 2)
    
    If clearLastRow >= outRow Then
        outWs.Range(outWs.Cells(outRow, outCol), _
                    outWs.Cells(clearLastRow, outCol + 1)).ClearContents
    End If

    ' REGXパターン登録
    Set regEx = CreateObject("VBScript.RegExp")
    With regEx
        .pattern = patternText
        .Global = True
        .IgnoreCase = False
    End With

For Each ws In ActiveWorkbook.Worksheets

    If ws.name <> outWs.name Then

        Set rng = ws.UsedRange
        
        Set c = rng.Find( _
            What:=searchTag, _
            LookIn:=xlValues, _
            LookAt:=xlPart, _
            SearchOrder:=xlByRows, _
            SearchDirection:=xlNext, _
            MatchCase:=False _
        )

        If Not c Is Nothing Then

            firstAddress = c.Address(External:=True)

            Do
                checkValue = CStr(c.Value2)

                If regEx.test(checkValue) Then

                    Set matches = regEx.Execute(checkValue)

                    For Each m In matches

                        outWs.Hyperlinks.Add _
                            Anchor:=outWs.Cells(outRow, outCol), _
                            Address:="", _
                            SubAddress:="'" & ws.name & "'!" & c.Address(False, False), _
                            TextToDisplay:=ws.name

                        outWs.Cells(outRow, outCol + 1).Value = CStr(m.Value)

                        outRow = outRow + 1

                    Next m

                End If

                Set c = rng.FindNext(c)

                If c Is Nothing Then Exit Do
                If c.Address(External:=True) = firstAddress Then Exit Do

            Loop

        End If

    End If

Next ws

Exit Sub

ERR_HANDLER:
    MsgBox "getTagList failed: " & Err.Description, vbExclamation

        
End Sub


' TAGリプレイス単体　ショートカットキーからの使用を想定
' 対象：TAG[]形式、セル完全一致、ネストタグ可
Public Sub editActiveTagAndReplaceAll()

    Dim srcCell As Range
    Dim beforeText As String
    Dim afterText As String
    Dim tagId As String

    Dim ws As Worksheet
    Dim c As Range
    Dim targetRange As Range
    Dim replaceCount As Long
    Dim firstAddress As String

    On Error GoTo ERR_HANDLER

    Set srcCell = ActiveCell
    beforeText = CStr(srcCell.Value)

    If Len(beforeText) = 0 Then
        MsgBox "アクティブセルが空です。", vbExclamation
        Exit Sub
    End If

    If Not IsTagFormat(beforeText) Then
        MsgBox "タグ形式ではありません。" & vbCrLf & _
               "想定形式: TAG[内容]", vbExclamation
        Exit Sub
    End If

    tagId = GetTagId(beforeText)

    afterText = InputBox( _
        Prompt:="タグを変更してください。" & vbCrLf & _
                "現在値: " & beforeText, _
        Title:="タグ変更: " & tagId, _
        Default:=beforeText _
    )

    ' キャンセル、または空欄は中止
    If afterText = "" Then
        Exit Sub
    End If

    If afterText = beforeText Then
        Exit Sub
    End If

    If Not IsTagFormat(afterText) Then
        MsgBox "変更後の値がタグ形式ではありません。" & vbCrLf & _
               "想定形式: TAG[内容]", vbExclamation
        Exit Sub
    End If


'    If GetTagId(afterText) <> tagId Then
'        MsgBox "タグ名は変更しない想定です。" & vbCrLf & _
'               "変更前: " & tagId & vbCrLf & _
'               "変更後: " & GetTagId(afterText), vbExclamation
'        Exit Sub
'    End If
'

    Application.ScreenUpdating = False

    For Each ws In ActiveWorkbook.Worksheets

        Set targetRange = ws.UsedRange

        Set c = targetRange.Find( _
            What:=beforeText, _
            LookIn:=xlValues, _
            LookAt:=xlWhole, _
            SearchOrder:=xlByRows, _
            SearchDirection:=xlNext, _
            MatchCase:=False _
        )

        If c Is Nothing Then GoTo lblNext
        firstAddress = c.Address(External:=True)

        Do
    
            If beforeText <> afterText Then
                c.Value = afterText
                replaceCount = replaceCount + 1
            End If

            Set c = targetRange.FindNext(c)
            
            If c Is Nothing Then Exit Do
            If c.Address(External:=True) = firstAddress Then Exit Do

        Loop
        
lblNext:
    Next ws

    Application.ScreenUpdating = True

    MsgBox "置換完了: " & replaceCount & " セル", vbInformation
    Exit Sub

ERR_HANDLER:
    Application.ScreenUpdating = True
    MsgBox "editActiveTagAndReplaceAll failed: " & Err.Description, vbExclamation

End Sub

Public Function fRetCellAddress(rng As Range) As String

    fRetCellAddress = rng.Address

End Function


Private Function IsTagFormat(ByVal text As String) As Boolean

    Dim regEx As Object

    Set regEx = CreateObject("VBScript.RegExp")

    With regEx
        .pattern = "^[^\[\]]+\[[^\]]*\]$"
        .Global = False
        .IgnoreCase = False
    End With

    IsTagFormat = regEx.test(text)

End Function

Private Function GetTagId(ByVal tagText As String) As String

    Dim p As Long

    p = InStr(1, tagText, "[", vbBinaryCompare)

    If p > 1 Then
        GetTagId = Left$(tagText, p - 1)
    Else
        GetTagId = ""
    End If

End Function

Public Sub replaceTagList( _
    ByVal tagId As String, _
    ByVal headerRangeText As String _
)

    Dim listWs As Worksheet
    Dim headerCell As Range
    Dim r As Long
    Dim baseCol As Long

    Dim linkCell As Range
    Dim beforeText As String
    Dim afterText As String

    Dim targetWs As Worksheet
    Dim targetAddress As String
    Dim targetCell As Range

    Dim h As Hyperlink

    On Error GoTo ERR_HANDLER

    Set listWs = ActiveSheet
    Set headerCell = listWs.Range(headerRangeText)

    r = headerCell.row + 1
    baseCol = headerCell.Column

    Do While listWs.Cells(r, baseCol).Value <> ""

        Set linkCell = listWs.Cells(r, baseCol)

        beforeText = CStr(listWs.Cells(r, baseCol + 1).Value)
        afterText = CStr(listWs.Cells(r, baseCol + 2).Value)

        ' 移行後が空欄でない場合のみ処理
        If Len(afterText) > 0 Then

            If linkCell.Hyperlinks.Count > 0 Then

                Set h = linkCell.Hyperlinks(1)

                Set targetCell = GetCellFromSubAddress(h.SubAddress)

                If Not targetCell Is Nothing Then
                    ' ハイパーリンク先セルの値を置換
                    targetCell.Value = Replace(CStr(targetCell.Value), beforeText, afterText)
                End If

            End If

        End If

        r = r + 1

    Loop

    MsgBox ("タグ置換完了")

    Exit Sub

ERR_HANDLER:
    MsgBox "replaceTagList failed: " & Err.Description, vbExclamation

End Sub

Private Function GetCellFromSubAddress(ByVal subAddressText As String) As Range

    Dim sheetName As String
    Dim cellAddress As String
    Dim pos As Long

    On Error GoTo ERR_HANDLER

    pos = InStr(1, subAddressText, "!", vbTextCompare)

    If pos = 0 Then
        Set GetCellFromSubAddress = Nothing
        Exit Function
    End If

    sheetName = Left$(subAddressText, pos - 1)
    cellAddress = Mid$(subAddressText, pos + 1)

    ' 'Sheet Name'!A1 のクォート除去
    If Left$(sheetName, 1) = "'" And Right$(sheetName, 1) = "'" Then
        sheetName = Mid$(sheetName, 2, Len(sheetName) - 2)
        sheetName = Replace(sheetName, "''", "'")
    End If

    Set GetCellFromSubAddress = ActiveWorkbook.Worksheets(sheetName).Range(cellAddress)

    Exit Function

ERR_HANDLER:
    Set GetCellFromSubAddress = Nothing

End Function

Private Function GetListLastRow( _
    ByVal ws As Worksheet, _
    ByVal startRow As Long, _
    ByVal startCol As Long, _
    ByVal colCount As Long _
) As Long

    Dim r As Long
    Dim c As Long
    Dim lastUsedRow As Long

    lastUsedRow = ws.UsedRange.row + ws.UsedRange.Rows.Count - 1

    For r = startRow To lastUsedRow

        Dim hasValue As Boolean
        hasValue = False

        For c = startCol To startCol + colCount - 1
            If Len(CStr(ws.Cells(r, c).Value)) > 0 Then
                hasValue = True
                Exit For
            End If
        Next c

        If Not hasValue Then
            GetListLastRow = r - 1
            Exit Function
        End If

    Next r

    GetListLastRow = lastUsedRow

End Function

' WS上のタグ指定をRegExpパターンへ変換
' 例:
'   TAG        -> TAG\[[^\]]*\]
'   TAG.*      -> TAG(\.[^.[]+)*\[[^\]]*\]
'   TAG.完了   -> TAG\.完了\[[^\]]*\]
'   TAG.完了.* -> TAG\.完了(\.[^.[]+)*\[[^\]]*\]
Public Function BuildTagPattern(ByVal tagSpec As String) As String

    Dim s As String
    Dim hasWildcard As Boolean

    s = Trim$(tagSpec)

    hasWildcard = (Right$(s, 2) = ".*")

    If hasWildcard Then
        s = Left$(s, Len(s) - 2)
    End If

    s = EscapeRegExp(s)

    If hasWildcard Then
        BuildTagPattern = s & "(\.[^.[]+)*\[[^\]]*\]"
    Else
        BuildTagPattern = s & "\[[^\]]*\]"
    End If

End Function

' Find用の先頭タグを取得
' 例: TAG.完了.* -> TAG
Public Function GetTagFindKey(ByVal tagSpec As String) As String

    Dim p As Long

    p = InStr(tagSpec, ".")

    If p > 0 Then
        GetTagFindKey = Left$(tagSpec, p - 1)
    Else
        GetTagFindKey = tagSpec
    End If

End Function

Public Function EscapeRegExp(ByVal text As String) As String

    Dim s As String

    s = text

    s = Replace(s, "\", "\\")
    s = Replace(s, ".", "\.")
    s = Replace(s, "+", "\+")
    s = Replace(s, "?", "\?")
    s = Replace(s, "^", "\^")
    s = Replace(s, "$", "\$")
    s = Replace(s, "(", "\(")
    s = Replace(s, ")", "\)")
    s = Replace(s, "{", "\{")
    s = Replace(s, "}", "\}")
    s = Replace(s, "|", "\|")
    s = Replace(s, "[", "\[")
    s = Replace(s, "]", "\]")

    EscapeRegExp = s

End Function

