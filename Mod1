Public Function ParseLayerLink( _
    ByVal linkText As String _
) As String

    linkText = Trim$(linkText)

    If Left$(linkText, 2) <> "L[" Then Exit Function

    Dim startPos As Long
    Dim endPos As Long

    startPos = InStr(linkText, "[") + 1
    endPos = InStr(startPos, linkText, "]")

    If endPos <= startPos Then Exit Function

    ParseLayerLink = Mid$( _
        linkText, _
        startPos, _
        endPos - startPos _
    )

End Function

Public Sub CopyLayer(ByVal templateName As String, _
                         ByVal copyName As String)
                         
Debug.Print "templateName = " & templateName
