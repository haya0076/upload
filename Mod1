'==================================================
' Function Map
'==================================================

Public Function BuildFunctionMap( _
    ByVal ws As Worksheet, _
    ByVal cols As Object, _
    ByVal startRow As Long _
) As Object

    Dim Result As Object
    Set Result = CreateObject("Scripting.Dictionary")


    Dim lastRow As Long

    lastRow = ws.Cells( _
        ws.rows.Count, _
        cols("コード") _
    ).End(xlUp).row


    Dim rowIndex As Long

    For rowIndex = startRow To lastRow

        Dim funcName As String

        funcName = Trim$(CStr( _
            ws.Cells( _
                rowIndex, _
                cols("関数名") _
            ).Value _
        ))


        If Len(funcName) > 0 Then

            Dim endFuncRow As Long

            endFuncRow = FindFunctionEndRow( _
                ws, _
                cols, _
                rowIndex, _
                lastRow _
            )


            If endFuncRow > 0 Then

                If Not Result.Exists(funcName) Then

                    Result.Add _
                        funcName, _
                        Array(rowIndex, endFuncRow)

                End If

            End If

        End If

    Next rowIndex


    Set BuildFunctionMap = Result

End Function


Public Function FindFunctionEndRow( _
    ByVal ws As Worksheet, _
    ByVal cols As Object, _
    ByVal startRow As Long, _
    ByVal lastRow As Long _
) As Long

    Dim rowIndex As Long

    For rowIndex = startRow + 1 To lastRow

        Dim levelValue As String
        Dim codeText As String

        levelValue = Trim$(CStr( _
            ws.Cells( _
                rowIndex, _
                cols("階層") _
            ).Value _
        ))

        codeText = LCase$(Trim$(CStr( _
            ws.Cells( _
                rowIndex, _
                cols("コード") _
            ).Value _
        )))


        If levelValue = "1" Then

            If codeText = "end sub" _
                Or codeText = "end function" _
                Or InStr(codeText, "end sub") > 0 _
                Or InStr(codeText, "end function") > 0 Then

                FindFunctionEndRow = rowIndex
                Exit Function

            End If

        End If

    Next rowIndex

End Function


'==================================================
' Recursive Expansion
'==================================================

Public Sub ExpandFunctionJp( _
    ByVal baseWs As Worksheet, _
    ByVal outWs As Worksheet, _
    ByVal baseCols As Object, _
    ByVal outCols As Object, _
    ByVal funcMap As Object, _
    ByVal funcName As String, _
    ByRef outRow As Long, _
    ByVal callStack As Object, _
    ByVal depth As Long _
)

    If callStack.Exists(funcName) Then

        WriteNestedWarning _
            outWs, _
            outCols, _
            outRow, _
            "' [SKIP] recursive call: " & funcName, _
            depth

        outRow = outRow + 1

        Exit Sub

    End If


    callStack.Add funcName, True


    Dim rowRange As Variant
    rowRange = funcMap(funcName)

    Dim startRow As Long
    Dim endRow As Long

    startRow = CLng(rowRange(0))
    endRow = CLng(rowRange(1))


    Dim rowIndex As Long

    For rowIndex = startRow To endRow

        CopyNestedCodeRow _
            baseWs, _
            outWs, _
            baseCols, _
            outCols, _
            rowIndex, _
            outRow, _
            depth

        outRow = outRow + 1


        Dim callText As String

        callText = Trim$(CStr( _
            baseWs.Cells( _
                rowIndex, _
                baseCols("呼び出し関数") _
            ).Value _
        ))


        If Len(callText) > 0 Then

            Dim calls As Variant
            calls = SplitCallFunctions(callText)

            Dim i As Long

            For i = LBound(calls) To UBound(calls)

                Dim callFunc As String
                callFunc = Trim$(CStr(calls(i)))


                If Len(callFunc) > 0 _
                    And callFunc <> funcName Then


                    If funcMap.Exists(callFunc) Then

                        ExpandFunctionJp _
                            baseWs:=baseWs, _
                            outWs:=outWs, _
                            baseCols:=baseCols, _
                            outCols:=outCols, _
                            funcMap:=funcMap, _
                            funcName:=callFunc, _
                            outRow:=outRow, _
                            callStack:=callStack, _
                            depth:=depth + 1

                    Else

                        WriteNestedWarning _
                            outWs, _
                            outCols, _
                            outRow, _
                            "' [WARN] Function not found: " & callFunc, _
                            depth + 1

                        outRow = outRow + 1

                    End If

                End If

            Next i

        End If

    Next rowIndex


    callStack.Remove funcName

End Sub


'==================================================
' Output
'==================================================

Private Sub CopyNestedCodeRow( _
    ByVal baseWs As Worksheet, _
    ByVal outWs As Worksheet, _
    ByVal baseCols As Object, _
    ByVal outCols As Object, _
    ByVal srcRow As Long, _
    ByVal dstRow As Long, _
    ByVal depth As Long _
)

    Dim codeText As String

    codeText = CStr( _
        baseWs.Cells( _
            srcRow, _
            baseCols("コード") _
        ).Value _
    )


    outWs.Cells( _
        dstRow, _
        outCols("階層") _
    ).Value = depth


    outWs.Cells( _
        dstRow, _
        outCols("コード") _
    ).Value = _
        String$(depth * 4, " ") & _
        LTrim$(codeText)


    outWs.Cells( _
        dstRow, _
        outCols("アドレス") _
    ).Value = _
        baseWs.Cells( _
            srcRow, _
            baseCols("アドレス") _
        ).Value


    outWs.Cells( _
        dstRow, _
        outCols("関数名") _
    ).Value = _
        baseWs.Cells( _
            srcRow, _
            baseCols("関数名") _
        ).Value


    outWs.Cells( _
        dstRow, _
        outCols("呼び出し関数") _
    ).Value = _
        baseWs.Cells( _
            srcRow, _
            baseCols("呼び出し関数") _
        ).Value

End Sub


Private Sub WriteNestedWarning( _
    ByVal outWs As Worksheet, _
    ByVal outCols As Object, _
    ByVal outRow As Long, _
    ByVal message As String, _
    ByVal depth As Long _
)

    outWs.Cells( _
        outRow, _
        outCols("階層") _
    ).Value = depth


    outWs.Cells( _
        outRow, _
        outCols("コード") _
    ).Value = _
        String$(depth * 4, " ") & _
        message

End Sub


