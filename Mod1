Public Sub SortSheetsByName()

    Dim wb As Workbook
    Set wb = ActiveWorkbook

    Application.ScreenUpdating = False

    On Error GoTo ERR_HANDLER

    Dim i As Long
    Dim j As Long
    Dim sheetCount As Long

    sheetCount = wb.Worksheets.Count

    For i = 1 To sheetCount - 1

        For j = i + 1 To sheetCount

            If UCase$(wb.Worksheets(i).Name) > _
               UCase$(wb.Worksheets(j).Name) Then

                wb.Worksheets(j).Move _
                    Before:=wb.Worksheets(i)

            End If

        Next j

    Next i

    Application.ScreenUpdating = True
    Exit Sub

ERR_HANDLER:

    Application.ScreenUpdating = True
    RaiseStatusError _
        Err.Number, _
        "SortSheetsByName", _
        Err.Description

