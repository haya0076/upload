' @Feature: KeyLookup
' @Section: Worker
' @Role: Getter
' @Summary: 指定されたWorkbook / Worksheet上で、キー列と戻り列を解決し、キーに対応する値を返す
' @Status: Review
Function GetValueByKey( _
    key As String, _
    wsName As String, _
    Optional keyColumnSpec As String = "[KEY]", _
    Optional returnColumnSpec As String = "[VAL]", _
    Optional errorValue As String = "#VALUE!", _
    Optional wbName As String = "" _
) As String

    Dim resolvedWbName As String
    Dim wbActive As Workbook
    Set wbActive = RequireCurrentWorkbook()
    
    resolvedWbName = IIf(wbName = "", wbActive.Name, wbName)

    If Not WorkbookExists(resolvedWbName) Then
        GetValueByKey = errorValue
        Exit Function
    End If
    
    Dim wb As Workbook
    Set wb = Workbooks(resolvedWbName)
    
    If Not WorksheetExists(wsName, wb) Then
        GetValueByKey = errorValue
        Exit Function
    End If

    ' 列指定文字列を列番号へ変換
    Dim keyColumn As Long
    Dim returnColumn As Long

    keyColumn = ResolveColumn( _
        keyColumnSpec, _
        wsName, _
        resolvedWbName _
    )

    returnColumn = ResolveColumn( _
        returnColumnSpec, _
        wsName, _
        resolvedWbName _
    )

    If keyColumn = 0 Or returnColumn = 0 Then
        GetValueByKey = errorValue
        Exit Function
    End If

    GetValueByKey = fGetCellData_to_GetCellData( _
        resolvedWbName, _
        wsName, _
        key, _
        keyColumn, _
        returnColumn, _
        errorValue _
    )
    

End Function

' @Feature: KeyLookup
' @Section: Worker
' @Role: Resolver
' @Summary: 列指定文字列を指定Workbook / Worksheet上の列番号へ解決する
' @Status: Review
Private Function ResolveColumn( _
    ByVal columnSpec As String, _
    ByVal wsName As String, _
    ByVal wbName As String _
) As Long

    If Len(columnSpec) = 0 Then Exit Function

    If Left$(columnSpec, 1) = "[" Then

        If Right$(columnSpec, 1) <> "]" Then Exit Function
        If Len(columnSpec) <= 2 Then Exit Function

        ResolveColumn = fSearchField_fPg_searchCol_to_FindColumnByHeader( _
            Mid$(columnSpec, 2, Len(columnSpec) - 2), _
            wsName, _
            wbName _
        )

    Else

        ResolveColumn = Workbooks(wbName) _
            .Worksheets(wsName) _
            .Columns(columnSpec) _
            .column

    End If

End Function

' @Feature: KeyLookup
' @Section: Worker
' @Role: Getter
' @Summary: 実データ取得
' @Status: Review
Private Function fGetCellData_to_GetCellData( _
    wbName As String, _
    wsName As String, _
    key As String, _
    keyColumn As Long, _
    returnColumn As Long, _
    Optional errorValue As String = "#VALUE!" _
) As String

    Dim keyColumnRange As Range
    Dim matchRow As Variant

    With Workbooks(wbName).Worksheets(wsName)

        Set keyColumnRange = .Columns(keyColumn)

        matchRow = Application.match(key, keyColumnRange, 0)

        If Not IsError(matchRow) Then
            fGetCellData_to_GetCellData = _
                .Cells(CLng(matchRow), returnColumn).Value
        Else
            fGetCellData_to_GetCellData = errorValue
        End If

    End With

End Function



