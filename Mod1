Public Sub BuildCodeCatalog(ByVal folderPath As String, ByVal destination As String)

    If Len(folderPath) = 0 Then Exit Sub

    Dim tbl As cls_TBL
    Set tbl = New cls_TBL

    tbl.InitHeaders CodeCatalogHeaders()
    
    ReadCatalogFiles folderPath, tbl
    
    If tbl.rowCount = 0 Then
        ShowStatus "取り込みがありません"
    End If
    
    ' シート出力
     OutputCodeCatalog tbl, destination
    

End Sub

Private Sub ReadCatalogFiles(ByVal folderPath As String, ByRef tbl As cls_TBL)
        
    Dim filePath As String
    filePath = Dir(folderPath & "\*.*")
    
    Do While Len(filePath) > 0

        Dim sourceText As String
        sourceText = ReadSourceFile(folderPath & "\" & filePath)

        ExtractProcedures sourceText, filePath, tbl

        filePath = Dir()

    Loop

End Sub

Private Function GetSourceFolderPath() As String

    With Application.FileDialog(msoFileDialogFolderPicker)

        If .Show <> -1 Then Exit Function

        GetSourceFolderPath = .SelectedItems(1)

    End With

End Function

Private Function ReadSourceFile( _
    ByVal filePath As String _
) As String

    Dim fileNo As Integer
    fileNo = FreeFile

    Open filePath For Input As #fileNo

    Dim lineText As String
    Dim sourceText As String

    Do Until EOF(fileNo)

        Line Input #fileNo, lineText

        sourceText = sourceText & _
                     lineText & vbCrLf

    Loop

    Close #fileNo

    ReadSourceFile = sourceText

End Function

Private Sub ExtractProcedures( _
    ByVal sourceText As String, _
    ByVal fileName As String, _
    ByRef tbl As cls_TBL _
)

    Dim featureRegex As Object
    Dim sectionRegex As Object
    Dim summaryRegex As Object
    Dim roleRegex As Object
    Dim noteRegex As Object
    Dim statusRegex As Object
    Dim defRegex As Object

    Set featureRegex = CreateObject("VBScript.RegExp")
    Set sectionRegex = CreateObject("VBScript.RegExp")
    Set summaryRegex = CreateObject("VBScript.RegExp")
    Set roleRegex = CreateObject("VBScript.RegExp")
    Set noteRegex = CreateObject("VBScript.RegExp")
    Set statusRegex = CreateObject("VBScript.RegExp")
    Set defRegex = CreateObject("VBScript.RegExp")

    With featureRegex
        .Global = False
        .IgnoreCase = True
        .pattern = "^\s*'\s*@Feature\s*:?\s*(.+)$"
    End With
    
    With sectionRegex
        .Global = False
        .IgnoreCase = True
        .pattern = "^\s*'\s*@Section\s*:?\s*(.+)$"
    End With
    
    With summaryRegex
        .Global = False
        .IgnoreCase = True
        .pattern = "^\s*'\s*@Summary\s*:?\s*(.+)$"
    End With
    
    With roleRegex
        .Global = False
        .IgnoreCase = True
        .pattern = "^\s*'\s*@Role\s*:?\s*(.+)$"
    End With
    
    With noteRegex
        .Global = False
        .IgnoreCase = True
        .pattern = "^\s*'\s*@Note\s*:?\s*(.+)$"
    End With
    
    With statusRegex
        .Global = False
        .IgnoreCase = True
        .pattern = "^\s*'\s*@Status\s*:?\s*(.+)$"
    End With
    
    With defRegex
        .Global = False
        .IgnoreCase = True
        .pattern = _
            "^\s*(Public|Private|Friend)?\s*" & _
            "(Sub|Function|Property\s+(Get|Let|Set))\s+" & _
            "([A-Za-z_][A-Za-z0-9_]*)"
    End With

    Dim lines() As String
    lines = Split(sourceText, vbCrLf)

    Dim lineText As Variant
    Dim pendingFeature As String
    Dim pendingSection As String
    Dim pendingSummary As String
    Dim pendingRole As String
    Dim pendingNote As String
    Dim pendingStatus As String

    For Each lineText In lines

        If featureRegex.test(CStr(lineText)) Then
        
            Dim featureMatch As Object
            Set featureMatch = featureRegex.Execute(CStr(lineText))(0)
            pendingFeature = Trim$(featureMatch.SubMatches(0))
        
        ElseIf sectionRegex.test(CStr(lineText)) Then
        
            Dim sectionMatch As Object
            Set sectionMatch = sectionRegex.Execute(CStr(lineText))(0)
            pendingSection = Trim$(sectionMatch.SubMatches(0))
            
        ElseIf summaryRegex.test(CStr(lineText)) Then
        
            Dim summaryMatch As Object
            Set summaryMatch = summaryRegex.Execute(CStr(lineText))(0)
            pendingSummary = Trim$(summaryMatch.SubMatches(0))
        
        ElseIf roleRegex.test(CStr(lineText)) Then

            Dim roleMatch As Object
            Set roleMatch = roleRegex.Execute(CStr(lineText))(0)

            pendingRole = Trim$(roleMatch.SubMatches(0))

        ElseIf noteRegex.test(CStr(lineText)) Then

            Dim noteMatch As Object
            Set noteMatch = noteRegex.Execute(CStr(lineText))(0)

            pendingNote = Trim$(noteMatch.SubMatches(0))

        ElseIf statusRegex.test(CStr(lineText)) Then

            Dim statusMatch As Object
            Set statusMatch = statusRegex.Execute(CStr(lineText))(0)

            pendingStatus = Trim$(statusMatch.SubMatches(0))
            
        ElseIf defRegex.test(CStr(lineText)) Then

            Dim defMatch As Object
            Set defMatch = defRegex.Execute(CStr(lineText))(0)

            tbl.addRow BuildCatalogRow( _
                fileName, _
                defMatch, _
                pendingFeature, _
                pendingSection, _
                pendingRole, _
                pendingSummary, _
                pendingNote, _
                pendingStatus _
            )
            
            pendingFeature = vbNullString
            pendingSection = vbNullString
            pendingRole = vbNullString
            pendingSummary = vbNullString
            pendingNote = vbNullString
            pendingStatus = vbNullString
    
        End If

    Next lineText

End Sub

Private Sub OutputCodeCatalog(ByRef tbl As cls_TBL, ByVal destination As String)

    ' destination 行にヘッダ出力
    Dim targetSheet As String
    Dim targetRange As String
    
    targetSheet = Split(destination, "!")(0)
    targetRange = Split(destination, "!")(1)
    
    Dim outputData As Variant
    outputData = tbl.ToArray
    
    With Sheets(targetSheet).Range(targetRange)
        .Resize( _
            tbl.rowCount + 1, _
            tbl.columnCount _
        ).Value = outputData
    End With

End Sub



