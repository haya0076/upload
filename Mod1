Private Function GetOutputFieldDefinitions() As Variant

    GetOutputFieldDefinitions = Array( _
        Array("SAP論理名", "sap論理名", 0), _
        Array("SAP物理名", "sap物理名", 0), _
        Array("SAP型", "sap型", 0), _
        Array("SAP桁数", "sap桁数", 0) _
    )

End Function

Private Function GetDefinitionWorkbookByPrefix( _
    ByVal definitionBooks As Collection, _
    ByVal tableName As String _
) As Workbook

    On Error GoTo lblError

    Dim prefix As String
    prefix = LCase$(Left$(Trim$(tableName), 2))

    If Len(prefix) < 2 Then
        Exit Function
    End If

    Dim searchText As String
    searchText = "_" & prefix & "_"

    Dim wb As Workbook

    For Each wb In definitionBooks

        If InStr( _
            1, _
            LCase$(wb.Name), _
            searchText, _
            vbTextCompare) > 0 Then

            Set GetDefinitionWorkbookByPrefix = wb
            Exit Function

        End If

    Next wb

    Exit Function

lblError:
    TraceError _
        "GetDefinitionWorkbookByPrefix", _
        Err.Number, _
        Err.Description

    Set GetDefinitionWorkbookByPrefix = Nothing

End Function

Private Function GetFieldInfo( _
    ByVal wbDefinition As Workbook, _
    ByVal sheetName As String, _
    ByVal physicalName As String, _
    ByVal fieldType As String, _
    ByVal shift As Long _
) As String

    On Error GoTo lblError

    Dim ws As Worksheet
    Set ws = GetWorksheetByName( _
                wbDefinition, _
                sheetName)

    If ws Is Nothing Then
        GetFieldInfo = "#SHEET_NOT_FOUND"
        Exit Function
    End If

    Dim lastCol As Long
    Dim matchCol As Long
    Dim colNo As Long

    ' 6行目の物理名から対象列を探す
    lastCol = ws.Cells(6, ws.Columns.Count) _
                .End(xlToLeft).Column

    For colNo = 2 To lastCol

        If StrComp( _
            Trim$(CStr(ws.Cells(6, colNo).value)), _
            Trim$(physicalName), _
            vbTextCompare) = 0 Then

            matchCol = colNo
            Exit For

        End If

    Next colNo

    If matchCol = 0 Then
        GetFieldInfo = "#FIELD_NOT_FOUND"
        Exit Function
    End If

    Dim resultValue As Variant

    Select Case LCase$(fieldType)

        Case "旧論理"
            resultValue = _
                ws.Cells(4 + shift, matchCol).value

        Case "旧型"
            resultValue = _
                ws.Cells(9 + shift, matchCol).value

        Case "旧db列"
            resultValue = _
                ws.Cells(10 + shift, matchCol).value

        Case "旧桁数"
            resultValue = _
                ws.Cells(11 + shift, matchCol).value

        Case "旧サンプル"
            resultValue = _
                ws.Cells(14 + shift, matchCol).value

        Case "sapテーブル"
            resultValue = _
                ws.Cells(115 + shift, matchCol).value

        Case "sap論理名"
            resultValue = _
                ws.Cells(116 + shift, matchCol).value

        Case "sap物理名"
            resultValue = _
                ws.Cells(117 + shift, matchCol).value

        Case "sap型"
            resultValue = _
                ws.Cells(118 + shift, matchCol).value

        Case "sap桁数"
            resultValue = _
                ws.Cells(119 + shift, matchCol).value

        Case Else
            GetFieldInfo = "#INVALID_FIELD_TYPE"
            Exit Function

    End Select

    If IsError(resultValue) Then
        GetFieldInfo = CStr(resultValue)
    Else
        GetFieldInfo = CStr(resultValue)
    End If

    Exit Function

lblError:
    TraceError _
        "GetFieldInfo", _
        Err.Number, _
        Err.Description

    GetFieldInfo = "#ERROR"

End Function

