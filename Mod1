' @Status: Keep
Public Sub RenameSheetAndUpdateLinks()

    Dim wb As Workbook
    Set wb = GetCurrentWorkbook()

    Dim ws As Worksheet
    Set ws = ActiveSheet

    Dim oldName As String
    oldName = ws.Name

    Dim newName As String
    newName = InputBox( _
        "新しいシート名を入力してください", _
        "シート名変更", _
        oldName _
    )

    newName = Trim$(newName)

    If Len(newName) = 0 Then
        ShowStatus "処理を中止しました"
        Exit Sub
    End If

    If newName = oldName Then Exit Sub

    If WorksheetExists(newName, wb) Then
        MsgBox "同じ名前のシートが既に存在します"
        Exit Sub
    End If

    Application.ScreenUpdating = False

    On Error GoTo ERR_HANDLER

    ws.Name = newName

    ReplaceLayerLinks _
        wb, _
        oldName, _
        newName

    Application.ScreenUpdating = True

    ShowStatus oldName & " → " & newName & _
        " に変更し、リンクを更新しました"

    Exit Sub

ERR_HANDLER:

    Application.ScreenUpdating = True

    RaiseStatusError _
        Err.Number, _
        "RenameSheetAndUpdateLinks", _
        Err.Description

End Sub

Private Sub ClearLayerLinks( _
    ByVal wb As Workbook, _
    ByVal SheetName As String _
)

    Dim keyword As String
    keyword = "L[" & SheetName & "]"

    Dim ws As Worksheet

    For Each ws In wb.Worksheets

        Dim foundCell As Range

        With ws.UsedRange

            Set foundCell = .Find( _
                What:=keyword, _
                LookIn:=xlValues, _
                LookAt:=xlWhole _
            )

            Do While Not foundCell Is Nothing

                foundCell.ClearContents

                Set foundCell = .Find( _
                    What:=keyword, _
                    LookIn:=xlValues, _
                    LookAt:=xlWhole _
                )

            Loop

        End With

    Next ws

End Sub

