    startRow = Selection.row
    parentCol = Selection.column


    Dim endRow As Long
    endRow = FindHierarchyEndRow( _
        ws, _
        startRow, _
        parentCol _
    )


    If endRow >= startRow + 1 Then

        ws.rows( _
            (startRow + 1) & ":" & endRow _
        ).Hidden = False

    End If


    ClearDoubleBorder _
        ws, _
        startRow, _
        parentCol

    ClearDoubleBorder _
        ws, _
        startRow, _
        parentCol + 1


End Sub

' @Feature: Tag
' @Section: KeyBind
' @Role: Replace
' @Summary: ActiveCellのTagを編集しWorkbook内の完全一致Tagを一括置換する
' @Status: Keep
Public Sub EditActiveTagAndReplaceAll()

    Dim wb As Workbook
    Set wb = GetCurrentWorkbook()

    Dim srcCell As Range
    Set srcCell = ActiveCell

    Dim beforeText As String
    beforeText = CStr(srcCell.Value)

    If Len(beforeText) = 0 Then
        MsgBox "アクティブセルが空です。", vbExclamation
        Exit Sub
    End If

    If Not IsTagFormat(beforeText) Then

        MsgBox _
            "タグ形式ではありません。" & vbCrLf & _
            "想定形式: TAG[内容]", _
            vbExclamation

        Exit Sub

    End If


    Dim tagId As String
    tagId = GetTagId(beforeText)


    Dim afterText As String

    afterText = InputBox( _
        Prompt:= _
            "タグを変更してください。" & vbCrLf & _
            "現在値: " & beforeText, _
        Title:="タグ変更: " & tagId, _
        Default:=beforeText _
    )

    If Len(afterText) = 0 Then Exit Sub

    If afterText = beforeText Then Exit Sub


    If Not IsTagFormat(afterText) Then

        MsgBox _
            "変更後の値がタグ形式ではありません。" & vbCrLf & _
            "想定形式: TAG[内容]", _
            vbExclamation

        Exit Sub

    End If


    Application.ScreenUpdating = False

    On Error GoTo ERR_HANDLER


    Dim ws As Worksheet
    Dim replaceCount As Long

    For Each ws In wb.Worksheets
    
        Dim targetRange As Range
        Set targetRange = ws.UsedRange
    
        Dim c As Range
    
        Set c = targetRange.Find( _
            What:=beforeText, _
            LookIn:=xlValues, _
            LookAt:=xlWhole, _
            SearchOrder:=xlByRows, _
            SearchDirection:=xlNext, _
            MatchCase:=False _
        )
    
        Do While Not c Is Nothing
    
            c.Value = afterText
            replaceCount = replaceCount + 1

        Set c = targetRange.Find( _
            What:=beforeText, _
            LookIn:=xlValues, _
            LookAt:=xlWhole, _
            SearchOrder:=xlByRows, _
            SearchDirection:=xlNext, _
            MatchCase:=False _
        )

    Loop

Next ws


    Application.ScreenUpdating = True

    ShowStatus "タグ置換完了: " & replaceCount & " セル"

    Exit Sub


ERR_HANDLER:

    Application.ScreenUpdating = True

    RaiseStatusError _
        Err.Number, _
        "EditActiveTagAndReplaceAll", _
        Err.Description

End Sub




