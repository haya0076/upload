' @Feature: Tag
' @Section: ExDSL
' @Role: Command
' @Summary: Tag一覧の移行後値をリンク先セルへ反映する
' @Status: Review
Public Sub ReplaceTagList( _
    ByVal tagId As String, _
    ByVal headerRangeText As String _
)

    Dim wb As Workbook
    Set wb = GetCurrentWorkbook()

    Dim listWs As Worksheet
    Set listWs = ActiveSheet

    Dim headerCell As Range
    Set headerCell = listWs.Range(headerRangeText)

    Dim rowIndex As Long
    Dim baseCol As Long

    rowIndex = headerCell.row + 1
    baseCol = headerCell.column


    Do While Len(CStr( _
        listWs.Cells(rowIndex, baseCol).Value2 _
    )) > 0

        Dim linkCell As Range
        Set linkCell = listWs.Cells(rowIndex, baseCol)

        Dim beforeText As String
        Dim afterText As String

        beforeText = CStr( _
            listWs.Cells(rowIndex, baseCol + 1).Value2 _
        )

        afterText = CStr( _
            listWs.Cells(rowIndex, baseCol + 2).Value2 _
        )


        If Len(afterText) > 0 Then

            If linkCell.Hyperlinks.Count > 0 Then

                Dim h As Hyperlink
                Set h = linkCell.Hyperlinks(1)

                Dim targetCell As Range

                Set targetCell = GetCellFromSubAddress( _
                    wb, _
                    h.SubAddress _
                )

                If Not targetCell Is Nothing Then

                    targetCell.Value = Replace( _
                        CStr(targetCell.Value), _
                        beforeText, _
                        afterText _
                    )

                End If

            End If

        End If

        rowIndex = rowIndex + 1

    Loop

    ShowStatus "タグ置換完了"

End Sub


