' @Feature: WorksheetEdit
' @Section: KeyBind
' @Role: Collapse
' @Summary: 選択セルの親階層配下を非表示にする
' @Status: Keep
Public Sub Hidden_rows()

    If TypeName(Selection) <> "Range" Then Exit Sub

    Dim ws As Worksheet
    Set ws = Selection.Worksheet

    Dim currentRow As Long
    Dim currentCol As Long

    currentRow = Selection.row
    currentCol = Selection.column

    If currentCol <= 1 Then
        MsgBox "親階層がありません", vbExclamation
        Exit Sub
    End If


    Dim parentCol As Long
    parentCol = currentCol - 1


    Dim startRow As Long
    startRow = FindParentRow( _
        ws, _
        currentRow, _
        parentCol _
    )

    If startRow = 0 Then Exit Sub


    Dim endRow As Long
    endRow = FindHierarchyEndRow( _
        ws, _
        startRow, _
        parentCol _
    )


    If endRow >= startRow + 1 Then

        ws.rows( _
            (startRow + 1) & ":" & endRow _
        ).Hidden = True

    End If


    SetDoubleBorder _
        ws, _
        startRow, _
        parentCol

    SetDoubleBorder _
        ws, _
        startRow, _
        currentCol


    Dim currentValue As String
    currentValue = CStr(ws.Cells(startRow, parentCol).Value)

    ws.Cells(startRow, parentCol).Value = currentValue


End Sub


' @Feature: WorksheetEdit
' @Section: KeyBind
