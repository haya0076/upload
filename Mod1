    Dim ws As Worksheet
    Set ws = Selection.Worksheet

    Dim rowIndex As Long
    Dim columnIndex As Long

    rowIndex = Selection.row
    columnIndex = Selection.column

    If rowIndex >= ws.rows.Count Then Exit Sub

    ws.rows(rowIndex).Cut
    ws.rows(rowIndex + 2).Insert Shift:=xlDown

    ws.Cells(rowIndex + 1, columnIndex).Select

    Application.CutCopyMode = False

End Sub

