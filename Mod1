' @Feature: Worksheet
' @Section: Hyperlink
' @Role: Resolver
' @Summary: HyperlinkのSubAddressをWorksheet Rangeへ解決する
' @Status: Keep
Public Function GetCellFromSubAddress( _
    ByVal wb As Workbook, _
    ByVal subAddressText As String _
) As Range

    Dim posSeparator As Long

    posSeparator = InStr( _
        1, _
        subAddressText, _
        "!", _
        vbTextCompare _
    )

    If posSeparator = 0 Then Exit Function


    Dim SheetName As String
    Dim cellAddress As String

    SheetName = Left$( _
        subAddressText, _
        posSeparator - 1 _
    )

    cellAddress = Mid$( _
        subAddressText, _
        posSeparator + 1 _
    )


    ' 'Sheet Name'!A1
    If Left$(SheetName, 1) = "'" _
        And Right$(SheetName, 1) = "'" Then

        SheetName = Mid$( _
            SheetName, _
            2, _
            Len(SheetName) - 2 _
        )

        SheetName = Replace( _
            SheetName, _
            "''", _
            "'" _
        )

    End If


    If Not WorksheetExists(SheetName, wb) Then
        Exit Function
    End If


    Set GetCellFromSubAddress = _
        wb.Worksheets(SheetName).Range(cellAddress)

End Function


