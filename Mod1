' @Feature: RegExp
' @Section: Helper
' @Role: Replace
' @Summary: 正規表現パターンに一致する文字列を置換する
' @Status: Keep
Public Function RegexReplace( _
    ByVal target As Variant, _
    ByVal pattern As String, _
    ByVal replaceText As String _
) As String

    Dim regEx As Object
    Set regEx = CreateObject("VBScript.RegExp")

    With regEx
        .pattern = pattern
        .Global = True
        .IgnoreCase = True
    End With

    RegexReplace = regEx.Replace( _
        CStr(target), _
        replaceText _
    )

End Function

' @Feature: RegExp
' @Section: Helper
' @Role: Extract
' @Summary: 正規表現に一致した文字列を抽出して結合する
' @Status: Keep
Public Function RegexExtract( _
    ByVal target As Variant, _
    ByVal pattern As String, _
    Optional ByVal joinDelimiter As String = "" _
) As String

    Dim regEx As Object
    Set regEx = CreateObject("VBScript.RegExp")

    With regEx
        .pattern = pattern
        .Global = True
        .IgnoreCase = True
    End With

    Dim matches As Object
    Set matches = regEx.Execute(CStr(target))

    Dim matchItem As Object
    Dim Result As String

    For Each matchItem In matches

        If Len(Result) > 0 Then
            Result = Result & joinDelimiter
        End If

        Result = Result & matchItem.Value

    Next matchItem

    RegexExtract = Result

End Function

' @Feature: RegExp
' @Section: Helper
' @Role: Escape
' @Summary: 文字列を正規表現リテラルとして使用できるようエスケープする
' @Status: Keep
Public Function EscapeRegExp( _
    ByVal text As String _
) As String

    Dim Result As String
    Result = text

    Result = Replace(Result, "\", "\\")
    Result = Replace(Result, ".", "\.")
    Result = Replace(Result, "+", "\+")
    Result = Replace(Result, "*", "\*")
    Result = Replace(Result, "?", "\?")
    Result = Replace(Result, "^", "\^")
    Result = Replace(Result, "$", "\$")
    Result = Replace(Result, "(", "\(")
    Result = Replace(Result, ")", "\)")
    Result = Replace(Result, "{", "\{")
    Result = Replace(Result, "}", "\}")
    Result = Replace(Result, "|", "\|")
    Result = Replace(Result, "[", "\[")
    Result = Replace(Result, "]", "\]")

    EscapeRegExp = Result

End Function




'========================================
' Mod_Sql_ExcelDb.bas
'========================================

'==================================================
' Excel DB Query
'==================================================

Public Function ExecuteExcelQuery( _
    ByVal dataFilePath As String, _
    ByVal sqlQuery As String _
) As ADODB.Recordset

    If Len(Trim$(sqlQuery)) = 0 Then

        RaiseStatusError _
            vbObjectError + 1500, _
            "ExecuteExcelQuery", _
            "SQL query is empty."

    End If


    If Len(Dir$(dataFilePath)) = 0 Then

        RaiseStatusError _
            vbObjectError + 1501, _
            "ExecuteExcelQuery", _
            "Data file not found: " & dataFilePath

    End If


    Dim cn As ADODB.Connection
    Dim rs As ADODB.Recordset
    
    Set cn = New ADODB.Connection
    Set rs = New ADODB.Recordset


    On Error GoTo ERR_HANDLER


    cn.ConnectionString = BuildExcelConnectionString(dataFilePath)


    cn.Open


    ' RecordsetをConnectionから切り離して返すためClient Cursor
    rs.CursorLocation = adUseClient
    rs.CursorType = adOpenStatic
    rs.LockType = adLockReadOnly

    Set rs.ActiveConnection = cn

    rs.Open sqlQuery


    ' 呼び出し元がConnectionを管理しなくてよいよう切断
    Set rs.ActiveConnection = Nothing

    cn.Close
    Set cn = Nothing


    Set ExecuteExcelQuery = rs

    Exit Function


ERR_HANDLER:

    Dim errorNumber As Long
    Dim errorDescription As String

    errorNumber = Err.Number
    errorDescription = Err.Description


    On Error Resume Next

    If Not rs Is Nothing Then
        If rs.State <> 0 Then rs.Close
    End If

    If Not cn Is Nothing Then
        If cn.State <> 0 Then cn.Close
    End If

    On Error GoTo 0


    RaiseStatusError _
        errorNumber, _
        "ExecuteExcelQuery", _
        errorDescription

End Function

Private Function BuildExcelConnectionString( _
    ByVal dataFilePath As String _
) As String

    BuildExcelConnectionString = _
        "Provider=Microsoft.ACE.OLEDB.12.0;" & _
        "Data Source=" & dataFilePath & ";" & _
        "Extended Properties=""" & _
            GetExcelExtendedProperties(dataFilePath) & _
        """;"

End Function

Private Function GetExcelExtendedProperties( _
    ByVal dataFilePath As String _
) As String

    Dim ext As String

    ext = LCase$(Mid$( _
        dataFilePath, _
        InStrRev(dataFilePath, ".") + 1 _
    ))

    Select Case ext

        Case "xlsx"
            GetExcelExtendedProperties = _
                "Excel 12.0 Xml;HDR=YES"

        Case "xlsm"
            GetExcelExtendedProperties = _
                "Excel 12.0 Macro;HDR=YES"

        Case "xls"
            GetExcelExtendedProperties = _
                "Excel 8.0;HDR=YES"

        Case Else
            RaiseStatusError _
                vbObjectError + 1500, _
                "GetExcelExtendedProperties", _
                "未対応のExcel形式です: " & ext

    End Select

End Function



'========================================
' Mod_Sql_Worksheet.bas
'========================================

'==================================================
' Query Flow
'==================================================

Public Sub RunSqlToSheet( _
    ByVal SheetName As String, _
    ByVal sqlQuery As String _
)

    Dim wb As Workbook
    Set wb = GetCurrentWorkbook
    
    wb.Save

    If Not WorksheetExists(SheetName, wb) Then

        RaiseStatusError _
            vbObjectError + 1510, _
            "RunSqlToSheet", _
            "Worksheet not found: " & SheetName

    End If


    If Len(wb.Path) = 0 Then

        RaiseStatusError _
            vbObjectError + 1511, _
            "RunSqlToSheet", _
            "Workbook must be saved before executing SQL."

    End If


    Dim dataFilePath As String

    dataFilePath = _
        wb.Path & _
        Application.PathSeparator & _
        wb.Name

    Application.ScreenUpdating = False

    On Error GoTo ERR_HANDLER


    Dim rs As ADODB.Recordset
    Set rs = New ADODB.Recordset

    Set rs = ExecuteExcelQuery( _
        dataFilePath, _
        sqlQuery _
    )


    If rs.BOF And rs.EOF Then

        Debug.Print "SQL: No results"

        rs.Close
        Set rs = Nothing

        Application.ScreenUpdating = True

        Exit Sub

    End If


    OutputSqlResultToWorksheet _
        rs, _
        wb.Worksheets(SheetName)


    rs.Close
    Set rs = Nothing

    Application.ScreenUpdating = True

    Exit Sub


ERR_HANDLER:

    Application.ScreenUpdating = True

    RaiseStatusError _
        Err.Number, _
        "RunSqlToSheet", _
        Err.Description

End Sub

'==================================================
' SQL Result Output
'==================================================

Public Sub OutputSqlResultToWorksheet( _
    ByVal rs As Object, _
    ByVal ws As Worksheet _
)

    If rs Is Nothing Then Exit Sub


    ws.Cells.Clear


    '----------------------------------
    ' Header
    '----------------------------------

    Dim columnIndex As Long

    For columnIndex = 0 To rs.Fields.Count - 1

        ws.Cells(1, columnIndex + 1).Value = _
            rs.Fields(columnIndex).Name

    Next columnIndex


    '----------------------------------
    ' Data
    '----------------------------------

    If Not (rs.BOF And rs.EOF) Then

        ws.Cells(2, 1).CopyFromRecordset rs

    End If


    ws.Columns.AutoFit

End Sub



