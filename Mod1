' @Feature: FileSystem
' @Section: Worker
' @Role: Builder
Private Function BuildFolderTreeTable( _
    ByVal rootPath As String _
) As cls_TBL

    Dim tbl As cls_TBL
    Set tbl = New cls_TBL

    tbl.InitHeaders Array( _
        "Level", _
        "Type", _
        "Name", _
        "FullPath" _
    )

    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")

    Dim rootFolder As Object
    Set rootFolder = fso.GetFolder(rootPath)

    AppendFolderTree tbl, rootFolder, 0

    Set BuildFolderTreeTable = tbl

