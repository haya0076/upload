Option Explicit

' [IN] アドレス    階層        関数名  呼び出し関数    コード
' [OUT] 階層 | コード | アドレス | 関数名 | 呼び出し関数
'
'M[BuildNestedCodeJp](MainProcess@@$A$1:$F$1@@$I$1:$M$1)
'MainProcess
'$A$1:$F$1
'$I$1:$M$1

' [DEF] Basコード ネスト展開 日本語ヘッダ版
Public Sub BuildNestedCodeJp( _
    ByVal entryPoint As String, _
    ByVal baseHeaderRangeText As String, _
    ByVal outputHeaderRangeText As String _
)

    Dim baseWs As Worksheet
    Dim outWs As Worksheet
    Dim baseHeader As Range
    Dim outHeader As Range

    Dim baseCols As Object
    Dim outCols As Object
    Dim funcMap As Object
    Dim callStack As Object

    Dim outRow As Long
    Dim clearLastRow As Long

    On Error GoTo ERR_HANDLER

    Set baseWs = ActiveSheet
    Set outWs = ActiveSheet

    Set baseHeader = baseWs.Range(baseHeaderRangeText)
    Set outHeader = outWs.Range(outputHeaderRangeText)

    Set baseCols = GetHeaderMap(baseWs, baseHeader.row, baseHeader.Column)
    Set outCols = GetHeaderMap(outWs, outHeader.row, outHeader.Column)

    If Not CheckBaseHeaders(baseCols) Then
        MsgBox "ベースシートのヘッダが不足しています。", vbExclamation
        Exit Sub
    End If

    If Not CheckOutputHeaders(outCols) Then
        MsgBox "出力シートのヘッダが不足しています。", vbExclamation
        Exit Sub
    End If

    Set funcMap = BuildFunctionMap(baseWs, baseCols, baseHeader.row + 1)

    If Not funcMap.Exists(entryPoint) Then
        MsgBox "エントリー関数が見つかりません: " & entryPoint, vbExclamation
        Exit Sub
    End If

    outRow = outHeader.row + 1

    clearLastRow = GetListLastRow(outWs, outRow, outHeader.Column, 4)

    If clearLastRow >= outRow Then
        outWs.Range(outWs.Cells(outRow, outHeader.Column), _
                    outWs.Cells(clearLastRow, outHeader.Column + 3)).ClearContents
    End If

    Set callStack = CreateObject("Scripting.Dictionary")

    Application.ScreenUpdating = False

' 呼び出し元
    ExpandFunctionJp _
        baseWs:=baseWs, _
        outWs:=outWs, _
        baseCols:=baseCols, _
        outCols:=outCols, _
        funcMap:=funcMap, _
        funcName:=entryPoint, _
        outRow:=outRow, _
        callStack:=callStack, _
        depth:=1
        
    Application.ScreenUpdating = True

    MsgBox "BuildNestedCodeJp 完了", vbInformation
    Exit Sub

ERR_HANDLER:
    Application.ScreenUpdating = True
    MsgBox "BuildNestedCodeJp failed: " & Err.Description, vbExclamation

End Sub

' [DEF] 関数MAP作成
Private Function BuildFunctionMap( _
    ByVal ws As Worksheet, _
    ByVal cols As Object, _
    ByVal startRow As Long _
) As Object

    Dim dic As Object
    Dim r As Long
    Dim lastRow As Long
    Dim funcName As String
    Dim startFuncRow As Long
    Dim endFuncRow As Long

    Set dic = CreateObject("Scripting.Dictionary")

    lastRow = ws.Cells(ws.rows.Count, cols("コード")).End(xlUp).row

    For r = startRow To lastRow

        funcName = Trim$(CStr(ws.Cells(r, cols("関数名")).Value))

        If Len(funcName) > 0 Then

            startFuncRow = r
            endFuncRow = FindEndRowByLevel(ws, cols, startFuncRow, lastRow)

            If endFuncRow > 0 Then
                If Not dic.Exists(funcName) Then
                    dic.Add funcName, Array(startFuncRow, endFuncRow)
                End If
            End If

        End If

    Next r

    Set BuildFunctionMap = dic

End Function

' [DEF] 関数展開
Private Sub ExpandFunctionJp( _
    ByVal baseWs As Worksheet, _
    ByVal outWs As Worksheet, _
    ByVal baseCols As Object, _
    ByVal outCols As Object, _
    ByVal funcMap As Object, _
    ByVal funcName As String, _
    ByRef outRow As Long, _
    ByVal callStack As Object, _
    ByVal depth As Long _
)

    Dim rows As Variant
    Dim startRow As Long
    Dim endRow As Long
    Dim r As Long

    Dim callText As String
    Dim calls As Variant
    Dim i As Long
    Dim callFunc As String

    If callStack.Exists(funcName) Then
        WriteWarnRow outWs, outCols, outRow, "' [SKIP] recursive call: " & funcName, depth
        outRow = outRow + 1
        Exit Sub
    End If

    callStack.Add funcName, True

    rows = funcMap(funcName)
    startRow = CLng(rows(0))
    endRow = CLng(rows(1))

    For r = startRow To endRow

        CopyNestedRow baseWs, outWs, baseCols, outCols, r, outRow, depth
        outRow = outRow + 1

        callText = Trim$(CStr(baseWs.Cells(r, baseCols("呼び出し関数")).Value))

        If Len(callText) > 0 Then

            calls = SplitCallFunctions(callText)

            For i = LBound(calls) To UBound(calls)

                callFunc = Trim$(CStr(calls(i)))

                If Len(callFunc) > 0 Then

                    ' 自分自身への代入は呼び出しではないので無視
                    If callFunc <> funcName Then

                        If funcMap.Exists(callFunc) Then
                            ExpandFunctionJp _
                            baseWs:=baseWs, _
                            outWs:=outWs, _
                            baseCols:=baseCols, _
                            outCols:=outCols, _
                            funcMap:=funcMap, _
                            funcName:=callFunc, _
                            outRow:=outRow, _
                            callStack:=callStack, _
                            depth:=depth + 1
                        Else
                            WriteWarnRow outWs, outCols, outRow, "' [WARN] Function not found: " & callFunc, depth + 1
                            outRow = outRow + 1
                        End If

                    End If

                End If

            Next i

        End If

    Next r

    callStack.Remove funcName

End Sub

' [DEF] 階層1のEnd行検索
Private Function FindEndRowByLevel( _
    ByVal ws As Worksheet, _
    ByVal cols As Object, _
    ByVal startRow As Long, _
    ByVal lastRow As Long _
) As Long

    Dim r As Long
    Dim levelValue As String
    Dim codeText As String

    For r = startRow + 1 To lastRow

        levelValue = Trim$(CStr(ws.Cells(r, cols("階層")).Value))
        codeText = Trim$(CStr(ws.Cells(r, cols("コード")).Value))

        If levelValue = "1" Then

            If LCase$(codeText) = "end sub" _
                Or LCase$(codeText) = "end function" _
                Or InStr(1, LCase$(codeText), "end sub", vbTextCompare) > 0 _
                Or InStr(1, LCase$(codeText), "end function", vbTextCompare) > 0 Then

                FindEndRowByLevel = r
                Exit Function

            End If

        End If

    Next r

    FindEndRowByLevel = 0

End Function

' [DEF] 出力行コピー
Private Sub CopyNestedRow( _
    ByVal baseWs As Worksheet, _
    ByVal outWs As Worksheet, _
    ByVal baseCols As Object, _
    ByVal outCols As Object, _
    ByVal srcRow As Long, _
    ByVal dstRow As Long, _
    ByVal depth As Long _
)

    Dim codeText As String

    codeText = CStr(baseWs.Cells(srcRow, baseCols("コード")).Value)

    outWs.Cells(dstRow, outCols("階層")).Value = depth

    outWs.Cells(dstRow, outCols("コード")).Value = _
        String(depth * 4, " ") & LTrim$(codeText)

    outWs.Cells(dstRow, outCols("アドレス")).Value = _
        baseWs.Cells(srcRow, baseCols("アドレス")).Value

    outWs.Cells(dstRow, outCols("関数名")).Value = _
        baseWs.Cells(srcRow, baseCols("関数名")).Value

    outWs.Cells(dstRow, outCols("呼び出し関数")).Value = _
        baseWs.Cells(srcRow, baseCols("呼び出し関数")).Value

End Sub

' [DEF] 警告行出力
Private Sub WriteWarnRow( _
    ByVal outWs As Worksheet, _
    ByVal outCols As Object, _
    ByVal outRow As Long, _
    ByVal message As String, _
    ByVal depth As Long _
)

    outWs.Cells(outRow, outCols("階層")).Value = depth
    outWs.Cells(outRow, outCols("コード")).Value = _
        String(depth * 4, " ") & message

End Sub

' [DEF] 呼び出し関数分割
Private Function SplitCallFunctions(ByVal callText As String) As Variant

    callText = Replace(callText, "，", ",")
    callText = Replace(callText, "、", ",")
    callText = Replace(callText, "|", ",")

    SplitCallFunctions = Split(callText, ",")

End Function

' [DEF] ヘッダMAP作成
Private Function GetHeaderMap( _
    ByVal ws As Worksheet, _
    ByVal headerRow As Long, _
    ByVal startCol As Long _
) As Object

    Dim dic As Object
    Dim c As Long
    Dim lastCol As Long
    Dim headerName As String

    Set dic = CreateObject("Scripting.Dictionary")

    lastCol = ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column

    For c = startCol To lastCol

        headerName = Trim$(CStr(ws.Cells(headerRow, c).Value))

        If Len(headerName) > 0 Then
            If Not dic.Exists(headerName) Then
                dic.Add headerName, c
            End If
        End If

    Next c

    Set GetHeaderMap = dic

End Function

' [DEF] ベースヘッダ確認
Private Function CheckBaseHeaders(ByVal cols As Object) As Boolean

    CheckBaseHeaders = _
        cols.Exists("アドレス") _
        And cols.Exists("階層") _
        And cols.Exists("関数名") _
        And cols.Exists("呼び出し関数") _
        And cols.Exists("コード")

End Function

' [DEF] 出力ヘッダ確認
Private Function CheckOutputHeaders(ByVal cols As Object) As Boolean

    CheckOutputHeaders = _
        cols.Exists("階層") _
        And cols.Exists("コード") _
        And cols.Exists("アドレス") _
        And cols.Exists("関数名") _
        And cols.Exists("呼び出し関数")

End Function

' [DEF] ヘッダ下の連続表最終行
Private Function GetListLastRow( _
    ByVal ws As Worksheet, _
    ByVal startRow As Long, _
    ByVal startCol As Long, _
    ByVal colCount As Long _
) As Long

    Dim r As Long
    Dim c As Long
    Dim lastUsedRow As Long
    Dim hasValue As Boolean

    If WorksheetFunction.CountA(ws.Cells) = 0 Then
        GetListLastRow = startRow - 1
        Exit Function
    End If

    lastUsedRow = ws.UsedRange.row + ws.UsedRange.rows.Count - 1

    For r = startRow To lastUsedRow

        hasValue = False

        For c = startCol To startCol + colCount - 1
            If Len(CStr(ws.Cells(r, c).Value)) > 0 Then
                hasValue = True
                Exit For
            End If
        Next c

        If Not hasValue Then
            GetListLastRow = r - 1
            Exit Function
        End If

    Next r

    GetListLastRow = lastUsedRow

End Function

