' [DEF]　汎用　リスト最終位置を出力
' @Feature: SheetMaintenance
' @Section: Worker
' @Role: Getter
' @Summary: 指定開始行から下方向へ走査し、指定列範囲が全て空になる直前の行番号を返す
' @Status: Review
Public Function GetListEndRow( _
    ByVal ws As Worksheet, _
    ByVal startRow As Long, _
    ByVal startCol As Long, _
    ByVal colCount As Long _
) As Long

    Dim r As Long
    Dim c As Long
    Dim lastUsedRow As Long
    Dim hasValue As Boolean

    If WorksheetFunction.CountA(ws.Cells) = 0 Then
        GetListEndRow = startRow - 1
        Exit Function
    End If

    lastUsedRow = ws.UsedRange.row + ws.UsedRange.rows.Count - 1

    For r = startRow To lastUsedRow

        hasValue = False
        
        '一行に一つでも値があればデータ行とみなす
        For c = startCol To startCol + colCount - 1
            If Len(CStr(ws.Cells(r, c).Value)) > 0 Then
                hasValue = True
                Exit For
            End If
        Next c

        If Not hasValue Then
            GetListEndRow = r - 1
            Exit Function
        End If

    Next r

    GetListEndRow = lastUsedRow

End Function

Public Sub ReplaceLayerLinks( _
    ByVal wb As Workbook, _
    ByVal oldSheetName As String, _
    ByVal newSheetName As String _
)

    Dim oldKeyword As String
    Dim newKeyword As String

    oldKeyword = "L[" & oldSheetName & "]"
    newKeyword = "L[" & newSheetName & "]"

    Dim ws As Worksheet

    For Each ws In wb.Worksheets

        Dim foundCell As Range
        Dim firstAddress As String

        With ws.UsedRange

            Set foundCell = .Find( _
                What:=oldKeyword, _
                LookIn:=xlValues, _
                LookAt:=xlPart _
            )

            If Not foundCell Is Nothing Then

                firstAddress = foundCell.Address

                Do

                    foundCell.Value = Replace( _
                        CStr(foundCell.Value), _
                        oldKeyword, _
                        newKeyword _
                    )

                    Set foundCell = .FindNext(foundCell)

                    If foundCell Is Nothing Then Exit Do

                Loop While foundCell.Address <> firstAddress

            End If

        End With

    Next ws

End Sub

