' @Feature: Layer
' @Section: ExDSL
' @Role: Command
' @Summary: 指定リストの順序をActiveWorkbookのWorksheetへ適用する
' @Status: Review
Public Sub ReorderSheets( _
    ByVal headerCell As String _
)

    Dim wb As Workbook
    Set wb = ActiveWorkbook
    
    Dim rng As Range
    Set rng = ActiveSheet.Range(headerCell)
    
    Dim row As Long
    row = rng.row + 1

    Dim sheetNameColumn As Long
    sheetNameColumn = rng.column

    Dim targetPosition As Long
    targetPosition = 1

    Dim SheetName As String

    Do While Len(Trim$(rng.Worksheet.Cells(row, sheetNameColumn).Value)) > 0

        SheetName = Trim$(rng.Worksheet.Cells(row, sheetNameColumn).Value)

        If WorksheetExists(SheetName, wb) Then

            If wb.Worksheets(SheetName).index <> targetPosition Then
                wb.Worksheets(SheetName).Move _
                    Before:=wb.Worksheets(targetPosition)
            End If

            targetPosition = targetPosition + 1

        End If

        row = row + 1

    Loop
    
    rng.Worksheet.Activate


End Sub

