        startCol, _
        colCount _
    )

    If lastRow < startRow Then Exit Sub

    ActiveSheet.Range( _
        ActiveSheet.Cells(startRow, startCol), _
        ActiveSheet.Cells(lastRow, startCol + colCount - 1) _
    ).ClearContents

