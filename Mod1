' @Feature: ExDSL
' @Section: Resolver
' @Role: Resolver
' @Summary: ExDSLのRange指定文字列をWorksheet Rangeへ解決する
' @Status: Keep
Public Function ResolveRangeArgument( _
    ByVal rangeText As String _
) As Range

    Dim wb As Workbook
    Set wb = GetCurrentWorkbook()

    rangeText = Trim$(rangeText)

    Dim posSeparator As Long
    posSeparator = InStr(1, rangeText, "!", vbTextCompare)

    If posSeparator = 0 Then

        Set ResolveRangeArgument = _
            ActiveSheet.Range(rangeText)

        Exit Function

    End If


    Dim SheetName As String
    Dim addressText As String

    SheetName = Left$(rangeText, posSeparator - 1)
    addressText = Mid$(rangeText, posSeparator + 1)


    ' 'Sheet Name'!A1 形式
    If Left$(SheetName, 1) = "'" _
        And Right$(SheetName, 1) = "'" Then

        SheetName = Mid$( _
            SheetName, _
            2, _
            Len(SheetName) - 2 _
        )

        SheetName = Replace( _
            SheetName, _
            "''", _
            "'" _
        )

    End If


    If Not WorksheetExists(SheetName, wb) Then

        RaiseStatusError _
            vbObjectError + 1400, _
            "ResolveRangeArgument", _
            "Worksheet not found: " & SheetName

    End If


    Set ResolveRangeArgument = _
        wb.Worksheets(SheetName).Range(addressText)

End Function



