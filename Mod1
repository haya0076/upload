Public Sub BuildCombinedBas( _
    ByVal folderPath As String, _
    ByVal outputFileName As String _
)

    If Right$(folderPath, 1) <> "\" Then
        folderPath = folderPath & "\"
    End If

    Dim outputPath As String
    outputPath = folderPath & outputFileName

    Dim outNo As Integer
    outNo = FreeFile

    Open outputPath For Output As #outNo

    On Error GoTo ERR_HANDLER

    Print #outNo, "Option Explicit"
    Print #outNo, vbCrLf

    ' Entry系
    AppendBasGroup _
        outNo, _
        folderPath, _
        True, _
        outputFileName

    ' その他
    AppendBasGroup _
        outNo, _
        folderPath, _
        False, _
        outputFileName

    Close #outNo

    ShowStatus "BAS結合完了: " & outputPath

    Exit Sub


ERR_HANDLER:

    Dim errNumber As Long
    Dim errDescription As String

    errNumber = Err.Number
    errDescription = Err.Description

    On Error Resume Next
    Close #outNo
    On Error GoTo 0

    RaiseStatusError _
        errNumber, _
        "BuildCombinedBas", _
        errDescription

End Sub


Private Sub AppendBasGroup( _
    ByVal outNo As Integer, _
    ByVal folderPath As String, _
    ByVal isEntry As Boolean, _
    ByVal excludeFileName As String _
)

    Dim fileName As String

    fileName = Dir$(folderPath & "*.bas")

    Do While Len(fileName) > 0

        ' 出力中の結合ファイル自身は除外
        If StrComp( _
            fileName, _
            excludeFileName, _
            vbTextCompare _
        ) <> 0 Then

            If IsEntryModuleFile(fileName) = isEntry Then
            
                AppendBasFile _
                    outNo, _
                    folderPath & fileName, _
                    fileName

            End If

        End If

        fileName = Dir$

    Loop

End Sub


Private Function IsEntryModuleFile( _
    ByVal fileName As String _
) As Boolean

    Select Case fileName

        Case _
            "Entry_Config.bas", _
            "Entry_Const.bas", _
            "Entry_KeyBind.bas", _
            "Entry_Main.bas"

            IsEntryModuleFile = True

    End Select

End Function


Private Sub AppendBasFile( _
    ByVal outNo As Integer, _
    ByVal filePath As String, _
    ByVal fileName As String _
)

    Dim fileNo As Integer
    fileNo = FreeFile

    Open filePath For Input As #fileNo

    On Error GoTo ERR_HANDLER

    Print #outNo, "'========================================"
    Print #outNo, "' " & fileName
    Print #outNo, "'========================================"

    Dim lineText As String

    Do Until EOF(fileNo)

        Line Input #fileNo, lineText

        If Left$(lineText, 17) <> "Attribute VB_Name" _
            And Trim$(lineText) <> "Option Explicit" Then

            Print #outNo, lineText

        End If

    Loop

    Close #fileNo

    Print #outNo, vbCrLf

    Exit Sub


ERR_HANDLER:

    Dim errNumber As Long
    Dim errDescription As String

    errNumber = Err.Number
    errDescription = Err.Description

    On Error Resume Next
    Close #fileNo
    On Error GoTo 0

    RaiseStatusError _
        errNumber, _
        "AppendBasFile", _
        errDescription

End Sub



