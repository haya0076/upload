Private Sub BuildTypeMismatchJoinTestTables( _
    ByRef tblLeft As cls_TBL, _
    ByRef tblRight As cls_TBL _
)

    Set tblLeft = New cls_TBL
    Set tblRight = New cls_TBL


    tblLeft.InitHeaders _
        Array( _
            "KeyValue", _
            "LeftValue" _
        )

    tblLeft.addRow _
        Array( _
            10, _
            "L1" _
        )


    tblRight.InitHeaders _
        Array( _
            "KeyValue", _
            "RightValue" _
        )

End Sub







