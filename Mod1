Public Sub Test_Query_TypeMismatch_NumberAndString()

    Dim tblLeft As cls_TBL
    Dim tblRight As cls_TBL

    BuildTypeMismatchJoinTestTables _
        tblLeft, _
        tblRight

    tblRight.addRow _
        Array( _
            "10", _
            "R1" _
        )


    Dim q As cls_TBL_Query
    Set q = tblLeft.CreateQuery

    q.InnerJoin _
        tblRight, _
        "KeyValue", _
        "KeyValue"


    PrintTestResult _
        "T34-1", _
        1, _
        q.Result.rowCount

End Sub

