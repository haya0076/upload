Public Function TextBetween( _
    ByVal src As String, _
    ByVal startStr As String, _
    ByVal endStr As String _
) As String

    Dim startPos As Long
    Dim endPos As Long

    startPos = InStr( _
        1, _
        src, _
        startStr, _
        vbBinaryCompare _
    )

    If startPos = 0 Then Exit Function

    startPos = startPos + Len(startStr)

    endPos = InStr( _
        startPos, _
        src, _
        endStr, _
        vbBinaryCompare _
    )

    If endPos = 0 Then Exit Function

    TextBetween = Mid$( _
        src, _
        startPos, _
        endPos - startPos _
    )

End Function


