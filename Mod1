        outWs, _
        outRow, _
        outCol, _
        5 _
    )

    If clearLastRow >= outRow Then

        outWs.Range( _
            outWs.Cells(outRow, outCol), _
            outWs.Cells(clearLastRow, outCol + 4) _
        ).ClearContents

    End If


    '----------------------------------
    ' Search settings
    '----------------------------------

    Dim searchTag As String
    Dim patternText As String

    searchTag = GetTagFindKey(tagId)
    patternText = BuildTagPattern(tagId)

    Dim regEx As Object
    Set regEx = CreateObject("VBScript.RegExp")

    With regEx
        .pattern = patternText
        .Global = True
        .IgnoreCase = False
    End With


    '----------------------------------
    ' Workbook search
    '----------------------------------

    Dim ws As Worksheet

    For Each ws In wb.Worksheets

        If ws.Name <> outWs.Name Then

            Dim rng As Range
            Set rng = ws.UsedRange

            Dim c As Range

            Set c = rng.Find( _
                What:=searchTag, _
                LookIn:=xlValues, _
                LookAt:=xlPart, _
                SearchOrder:=xlByRows, _
                SearchDirection:=xlNext, _
                MatchCase:=False _
            )

            If Not c Is Nothing Then

                Dim firstAddress As String
                firstAddress = c.Address(External:=True)

                Do

                    Dim checkValue As String
                    checkValue = CStr(c.Value2)

                    If regEx.test(checkValue) Then

                        Dim matches As Object
                        Set matches = regEx.Execute(checkValue)

                        Dim matchItem As Object

                        For Each matchItem In matches

                            outWs.Hyperlinks.Add _
                                Anchor:=outWs.Cells(outRow, outCol), _
                                Address:="", _
                                SubAddress:= _
                                    "'" & ws.Name & "'!" & _
                                    c.Address(False, False), _
                                TextToDisplay:=ws.Name

                            outWs.Cells(outRow, outCol + 1).Value = _
                                CStr(matchItem.Value)

                            outRow = outRow + 1

                        Next matchItem

                    End If

                    Set c = rng.FindNext(c)

                    If c Is Nothing Then Exit Do

                    If c.Address(External:=True) = firstAddress Then
                        Exit Do
                    End If

                Loop

            End If

        End If

    Next ws

End Sub


