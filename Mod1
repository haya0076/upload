Public Function SplitCallFunctions( _
    ByVal callText As String _
) As Variant

    callText = Replace(callText, "，", ",")
    callText = Replace(callText, "、", ",")
    callText = Replace(callText, "|", ",")

    SplitCallFunctions = Split( _
        callText, _
        "," _
    )

End Function



