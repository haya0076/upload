Option Explicit
' 移送表シートの設定
Public Const RNG_PATH_IN_ISOU = "C4"
Public Const RNG_PATH_IN_HIKAKU = "C5"
Public Const RNG_SHT_NAME = "MAIN"

' 比較一覧シートの設定
Public Const SHT_NAME_COMPARE As String = "比較一覧"

Public Const ROW_COMPARE_START As Long = 2
Public Const COL_COMPARE_TABLE As Long = 1
Public Const COL_COMPARE_FIELD As Long = 2

Public Const SHT_NAME_OUTPUT_LIST As String = "OUT_一覧"


Public Sub execute_main()

 Call Main

End Sub

Public Sub Main()
    On Error GoTo lblError
    
    TraceStart "Main"
    
    Dim pathInIsou As String
    Dim pathInHikaku As String


    '=========================================
    ' 入力情報の取得
    '=========================================
    pathInIsou = ThisWorkbook.Worksheets(RNG_SHT_NAME).Range(RNG_PATH_IN_ISOU).value
    pathInHikaku = ThisWorkbook.Worksheets(RNG_SHT_NAME).Range(RNG_PATH_IN_HIKAKU).value
    
    TraceInfo "移送表フォルダ", pathInIsou
    TraceInfo "比較定義書フォルダ", pathInHikaku
    
    
    '=========================================
    ' 入力値の妥当性確認
    '=========================================
    Dim checkItems As Variant
    
    checkItems = Array( _
        Array("移送表フォルダ", pathInIsou), _
        Array("比較定義書フォルダ", pathInHikaku) _
    )
        
    If Not ValidateInput(checkItems) Then GoTo lblEnd
      
      
    '=========================================
    ' 比較一覧を開く
    '=========================================
    Dim definitionBooks As Collection
    Set definitionBooks = OpenDefinitionBooks(pathInHikaku)
      
      
    '=========================================
    ' 移送表フォルダの走査
    '=========================================
    Call ProcessTransferFolder(pathInIsou, definitionBooks)
    

    MsgBox "処理が完了しました。", vbInformation


lblEnd:
    '=========================================
    ' 終了処理
    '=========================================
    If Not definitionBooks Is Nothing Then
        Call CloseDefinitionBooks(definitionBooks)
    End If
    
    TraceEnd "Main"
    Exit Sub

lblError:
    TraceError "Main", Err.Number, Err.Description
    MsgBox "不明なエラーが発生しました：" & Err.Description, vbExclamation
    Resume lblEnd

End Sub

Private Function ValidateInput(ByVal checkItems As Variant) As Boolean

    Dim errMsg As String

    errMsg = ValidateRequiredValues(checkItems)
    If errMsg <> "" Then
        MsgBox errMsg, vbExclamation
        Exit Function
    End If

    errMsg = ValidateFolderExists(checkItems)
    If errMsg <> "" Then
        MsgBox errMsg, vbExclamation
        Exit Function
    End If

    ValidateInput = True

End Function

Private Function ValidateRequiredValues(ByVal items As Variant) As String

    Dim i As Long
    Dim label As String
    Dim value As String
    Dim message As String

    For i = LBound(items) To UBound(items)
        label = CStr(items(i)(0))
        value = Trim(CStr(items(i)(1)))

        If value = "" Then
            message = message & "・" & label & " が未入力です。" & vbCrLf
        End If
    Next i

    ValidateRequiredValues = message

End Function

Private Function ValidateFolderExists(ByVal items As Variant) As String

    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")

    Dim i As Long
    Dim label As String
    Dim folderPath As String
    Dim message As String

    For i = LBound(items) To UBound(items)
        label = CStr(items(i)(0))
        folderPath = Trim(CStr(items(i)(1)))

        If folderPath <> "" Then
            If Not fso.FolderExists(folderPath) Then
                message = message & "・" & label & " が存在しません：" & vbCrLf
                message = message & "  " & folderPath & vbCrLf
            End If
        End If
    Next i

    ValidateFolderExists = message

End Function

Public Function OpenDefinitionBooks(ByVal folderPath As String) As Collection

    On Error GoTo lblError

    TraceStart "OpenDefinitionBooks"

    Dim books As Collection
    Set books = New Collection

    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")

    Dim objFolder As Object
    Dim objFile As Object

    Set objFolder = fso.GetFolder(folderPath)

    For Each objFile In objFolder.Files

        ' Excelファイルのみ対象
        Select Case LCase(fso.GetExtensionName(objFile.Name))
            Case "xlsx", "xlsm", "xls"

                TraceInfo "Open", objFile.Name

                books.Add Workbooks.Open(objFile.Path)

        End Select

    Next objFile

    TraceInfo "OpenBookCount", books.Count

    Set OpenDefinitionBooks = books

lblEnd:

    TraceEnd "OpenDefinitionBooks"
    Exit Function

lblError:

    TraceError "OpenDefinitionBooks", Err.Number, Err.Description
    Resume lblEnd

End Function

Public Sub ProcessTransferFolder( _
    ByVal folderPath As String, _
    ByVal definitionBooks As Collection _
)

    On Error GoTo lblError

    TraceStart "ProcessTransferFolder"

    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")

    Dim objFolder As Object
    Dim objFile As Object

    Set objFolder = fso.GetFolder(folderPath)

    For Each objFile In objFolder.Files

        If IsExcelFile(objFile.Name) Then
            TraceInfo "移送表処理開始", objFile.Name
            Call ProcessTransferBook(objFile.Path, definitionBooks)
            TraceInfo "移送表処理終了", objFile.Name
        End If

    Next objFile

lblEnd:
    TraceEnd "ProcessTransferFolder"
    Exit Sub

lblError:
    TraceError "ProcessTransferFolder", Err.Number, Err.Description
    Resume lblEnd

End Sub

Private Sub ProcessTransferBook( _
    ByVal filePath As String, _
    ByVal definitionBooks As Collection _
)

    On Error GoTo lblError

    TraceStart "ProcessTransferBook"

    Dim wb As Workbook
    Set wb = Workbooks.Open(filePath, ReadOnly:=True)

    TraceInfo "Open移送表", wb.Name

    Dim wsCompare As Worksheet
    Set wsCompare = GetWorksheetByName(wb, SHT_NAME_COMPARE)

    If wsCompare Is Nothing Then
        TraceInfo "比較一覧シートなし", wb.Name
        GoTo lblEnd
    End If

    Dim transferDict As Object
    Set transferDict = BuildTransferDictionary(wsCompare)

    Dim wsOut As Worksheet
    Set wsOut = CreateOutputSheetForTransfer(wb.Name)

    Call AppendOutputList(wb.Name, wsOut.Name, transferDict.Count)

    Call WriteTransferDictionary(wsOut, transferDict)

lblEnd:
    If Not wb Is Nothing Then
        wb.Close SaveChanges:=False
    End If

    TraceEnd "ProcessTransferBook"
    Exit Sub

lblError:
    TraceError "ProcessTransferBook", Err.Number, Err.Description
    Resume lblEnd

End Sub

Private Function GetWorksheetByName( _
    ByVal wb As Workbook, _
    ByVal sheetName As String _
) As Worksheet

    On Error Resume Next
    Set GetWorksheetByName = wb.Worksheets(sheetName)
    On Error GoTo 0

End Function

Private Function BuildTransferDictionary(ByVal ws As Worksheet) As Object

    TraceStart "BuildTransferDictionary"

    Dim dict As Object
    Set dict = CreateObject("Scripting.Dictionary")

    Dim lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, COL_COMPARE_TABLE).End(xlUp).Row

    Dim rowNo As Long
    Dim tableName As String
    Dim fieldName As String
    Dim key As String
    Dim item As Object

    For rowNo = ROW_COMPARE_START To lastRow

        tableName = Trim(CStr(ws.Cells(rowNo, COL_COMPARE_TABLE).value))
        fieldName = Trim(CStr(ws.Cells(rowNo, COL_COMPARE_FIELD).value))

        If tableName <> "" And fieldName <> "" Then

            key = MakeTransferKey(tableName, fieldName)

            If Not dict.Exists(key) Then
                Set item = CreateObject("Scripting.Dictionary")
                item("RowNo") = rowNo
                item("TableName") = tableName
                item("FieldName") = fieldName

                dict.Add key, item
            End If

        End If

    Next rowNo

    TraceInfo "TransferDictCount", dict.Count

    Set BuildTransferDictionary = dict

    TraceEnd "BuildTransferDictionary"

End Function

Private Function MakeTransferKey( _
    ByVal tableName As String, _
    ByVal fieldName As String _
) As String

    MakeTransferKey = NormalizeKeyText(tableName) & "|" & NormalizeKeyText(fieldName)

End Function

Private Function NormalizeKeyText(ByVal value As String) As String

    value = Trim(CStr(value))
    value = Replace(value, "　", "")
    value = Replace(value, " ", "")
    NormalizeKeyText = LCase$(value)

End Function

Private Function CreateOutputSheetForTransfer(ByVal sourceBookName As String) As Worksheet

    Dim sheetName As String
    sheetName = SafeSheetName(sourceBookName)

    Dim ws As Worksheet
    Set ws = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Worksheets(ThisWorkbook.Worksheets.Count))
    ws.Name = sheetName

    ws.Range("A1").value = "元行番号"
    ws.Range("B1").value = "テーブル名"
    ws.Range("C1").value = "項目名"
    ws.Range("D1").value = "取得結果"
    ws.Range("E1").value = "備考"

    Set CreateOutputSheetForTransfer = ws

End Function

Private Function SafeSheetName(ByVal value As String) As String

    value = Replace(value, ".xlsx", "")
    value = Replace(value, ".xlsm", "")
    value = Replace(value, ".xls", "")

    value = Replace(value, "\", "_")
    value = Replace(value, "/", "_")
    value = Replace(value, ":", "_")
    value = Replace(value, "*", "_")
    value = Replace(value, "?", "_")
    value = Replace(value, "[", "_")
    value = Replace(value, "]", "_")

    SafeSheetName = Left$(value, 31)

End Function

Private Sub WriteTransferDictionary( _
    ByVal wsOut As Worksheet, _
    ByVal transferDict As Object _
)

    Dim rowOut As Long
    rowOut = 2

    Dim key As Variant
    Dim item As Object

    For Each key In transferDict.Keys

        Set item = transferDict(key)

        wsOut.Cells(rowOut, 1).value = item("RowNo")
        wsOut.Cells(rowOut, 2).value = item("TableName")
        wsOut.Cells(rowOut, 3).value = item("FieldName")
        wsOut.Cells(rowOut, 4).value = "未取得"
        wsOut.Cells(rowOut, 5).value = CStr(key)

        rowOut = rowOut + 1

    Next key

End Sub

Private Sub AppendOutputList( _
    ByVal sourceBookName As String, _
    ByVal outputSheetName As String, _
    ByVal itemCount As Long _
)

    Dim wsList As Worksheet
    Set wsList = EnsureOutputListSheet()

    Dim nextRow As Long
    nextRow = wsList.Cells(wsList.Rows.Count, 1).End(xlUp).Row + 1

    If nextRow < 2 Then nextRow = 2

    wsList.Cells(nextRow, 1).value = nextRow - 1
    wsList.Cells(nextRow, 2).value = sourceBookName
    wsList.Cells(nextRow, 3).value = outputSheetName
    wsList.Cells(nextRow, 4).value = itemCount

    wsList.Hyperlinks.Add _
        Anchor:=wsList.Cells(nextRow, 1), _
        Address:="", _
        SubAddress:="'" & outputSheetName & "'!A1", _
        TextToDisplay:=CStr(nextRow - 1)

End Sub

Private Function EnsureOutputListSheet() As Worksheet

    Dim ws As Worksheet
    Set ws = GetWorksheetByName(ThisWorkbook, SHT_NAME_OUTPUT_LIST)

    If ws Is Nothing Then
        Set ws = ThisWorkbook.Worksheets.Add(Before:=ThisWorkbook.Worksheets(1))
        ws.Name = SHT_NAME_OUTPUT_LIST

        ws.Range("A1").value = "No"
        ws.Range("B1").value = "元ファイル名"
        ws.Range("C1").value = "出力シート名"
        ws.Range("D1").value = "対象項目数"
    End If

    Set EnsureOutputListSheet = ws

End Function

Private Function IsExcelFile(ByVal fileName As String) As Boolean

    Dim ext As String
    ext = LCase$(Mid$(fileName, InStrRev(fileName, ".") + 1))

    Select Case ext
        Case "xlsx", "xlsm", "xls"
            IsExcelFile = True
        Case Else
            IsExcelFile = False
    End Select

End Function

Public Sub CloseDefinitionBooks(ByVal books As Collection)

    Dim wb As Workbook

    For Each wb In books
        wb.Close SaveChanges:=False
    Next wb

End Sub


